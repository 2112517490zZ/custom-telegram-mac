+[[nodiscard]] QString KindLabel(not_null<PeerData*> peer) {
+	if (peer->isUser()) {
+		return peer->isBot()
+			? QString::fromUtf8("机器人")
+			: QString::fromUtf8("用户");
+	} else if (peer->isChat() || peer->isMegagroup()) {
+		return QString::fromUtf8("群组");
+	} else if (peer->isBroadcast()) {
+		return QString::fromUtf8("频道");
+	}
+	return QString::fromUtf8("其他");
+}
+
+} // namespace
+
+SearchPanel::SearchPanel(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller)
+: Ui::RpWidget(parent)
+, _controller(controller)
+, _title(new QLabel(QString::fromUtf8("当前帐号消息搜索"), this))
+, _query(new QLineEdit(this))
+, _all(new QPushButton(QString::fromUtf8("全部"), this))
+, _user(new QPushButton(QString::fromUtf8("用户"), this))
+, _group(new QPushButton(QString::fromUtf8("群组"), this))
+, _channel(new QPushButton(QString::fromUtf8("频道"), this))
+, _bot(new QPushButton(QString::fromUtf8("机器人"), this))
+, _hint(new QLabel(QString::fromUtf8("底部显示搜索结果"), this))
+, _list(new QListWidget(this))
+, _timer([=] { requestSearch(); }) {
+	setAcceptDrops(true);
+	_title->setStyleSheet("color:#c2410c;font-weight:700;font-size:12px;");
+	_query->setPlaceholderText(QString::fromUtf8("输入关键词，搜这个号的全部消息"));
+	_query->setClearButtonEnabled(true);
+	_hint->setStyleSheet("color:#7a8790;font-size:11px;");
+	_list->setStyleSheet(
+		"QListWidget{border:0;background:#fff;}"
+		"QListWidget::item{padding:8px;border-bottom:1px solid #eef1f3;}");
+	const auto buttons = { _all, _user, _group, _channel, _bot };
+	for (const auto button : buttons) {
+		button->setCheckable(true);
+		button->setCursor(Qt::PointingHandCursor);
+		button->setStyleSheet(
+			"QPushButton{background:#fff;border:1px solid #d5dde3;"
+			"border-radius:8px;padding:4px 8px;}"
+			"QPushButton:checked{background:#3390ec;color:#fff;border:0;}");
+	}
+	_all->setChecked(true);
+
+	connect(_query, &QLineEdit::textChanged, this, [=](const QString &text) {
+		_text = text.trimmed();
+		_timer.cancel();
+		if (_text.isEmpty()) {
+			_list->clear();
+			_hits.clear();
+			_hint->setText(QString::fromUtf8("底部显示搜索结果"));
+			return;
+		}
+		_timer.callOnce(320);
+	});
+	connect(_all, &QPushButton::clicked, this, [=] { setFilter(Filter::All); });
+	connect(_user, &QPushButton::clicked, this, [=] { setFilter(Filter::User); });
+	connect(_group, &QPushButton::clicked, this, [=] { setFilter(Filter::Group); });
+	connect(_channel, &QPushButton::clicked, this, [=] { setFilter(Filter::Channel); });
+	connect(_bot, &QPushButton::clicked, this, [=] { setFilter(Filter::Bot); });
+	connect(_list, &QListWidget::itemClicked, this, [=](QListWidgetItem *) {
+		openRow(_list->currentRow());
+	});
+}
+
+void SearchPanel::setFilter(Filter filter) {
+	_filter = filter;
+	_all->setChecked(filter == Filter::All);
+	_user->setChecked(filter == Filter::User);
+	_group->setChecked(filter == Filter::Group);
+	_channel->setChecked(filter == Filter::Channel);
+	_bot->setChecked(filter == Filter::Bot);
+	if (!_text.isEmpty()) {
+		requestSearch();
+	}
+}
