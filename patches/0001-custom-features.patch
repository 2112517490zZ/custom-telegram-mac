+LoginSheet::LoginSheet(QFrame *sheet)
+: QObject(sheet)
+, _sheet(sheet) {
+	BeginLoginSheet();
+	_sheet->setObjectName(u"loginSheet"_q);
+	_sheet->setStyleSheet(
+		"QFrame#loginSheet{background:#1c2733;border:1px solid #3e5670;border-radius:14px;}"
+		"QLabel{color:#e8f0f7;background:transparent;}"
+		"QPushButton{background:#2b5278;color:#ffffff;border:0;border-radius:8px;padding:9px 12px;font-size:13px;}"
