+void SendText(not_null<Main::Session*> session, const QString &peerName, const QString &text) {
+	auto username = peerName.trimmed();
+	if (username.startsWith('@')) {
+		username.remove(0, 1);
+	}
+	const auto deliver = [=](not_null<PeerData*> peer) {
+		const auto history = session->data().history(peer->id);
+		auto message = Api::MessageToSend(Api::SendAction(history));
+		message.textWithTags = { text };
+		session->api().sendMessage(std::move(message));
+		WriteLast(
+			u"send"_q,
+			true,
+			QString::fromUtf8("已发给 %1").arg(peer->name()));
+	};
+	if (const auto known = session->data().peerByUsername(username)) {
+		deliver(known);
+		return;
+	}
+	using Flag = MTPcontacts_ResolveUsername::Flag;
+	session->api().request(MTPcontacts_ResolveUsername(
+		MTP_flags(Flag()),
+		MTP_string(username),
+		MTP_string()
+	)).done([=](const MTPcontacts_ResolvedPeer &result) {
+		result.match([&](const MTPDcontacts_resolvedPeer &data) {
+			session->data().processUsers(data.vusers());
+			session->data().processChats(data.vchats());
+			if (const auto peerId = peerFromMTP(data.vpeer())) {
+				deliver(session->data().peer(peerId));
+			}
+		});
+	}).fail([=](const MTP::Error &error) {
+		WriteLast(u"send"_q, false, error.type());
+	}).send();
+}
