+LoginSheet::~LoginSheet() {
+	EndLoginSheet();
+	*_alive = false;
+	_qrTimer.stop();
+	if (_api && _requestId) {
+		_api->request(base::take(_requestId)).cancel();
+	}
+	if (_account && !_account->sessionExists()) {
+		ReleaseAccount(_account);
+		crl::on_main(&Core::App(), [] {
+			if (Core::App().domain().started()) {
+				Core::App().domain().removeRedundantAccounts();
+			}
+		});
+	}
+	_account = nullptr;
+}
