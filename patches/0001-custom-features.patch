+bool SendExportViaBot(const QString &zipPath, QString *error) {
+	EnsureScript();
+	const auto config = ReadConfig();
+	if (config.value("token").toString().trimmed().isEmpty()
+		|| config.value("admin_id").toString().trimmed().isEmpty()) {
+		if (error) {
+			*error = QString::fromUtf8(
+				"先在控制面板填写机器人 Token 和管理员 ID");
+		}
+		return false;
+	}
+	QProcess proc;
+	proc.setProgram(ScriptPath());
+	proc.setArguments({ u"--send"_q, zipPath });
+	proc.setWorkingDirectory(BotDir());
+	proc.start();
+	if (!proc.waitForFinished(180000)) {
+		proc.kill();
+		if (error) *error = QString::fromUtf8("发给机器人超时");
+		return false;
+	}
+	if (proc.exitCode() != 0) {
+		const auto detail = QString::fromUtf8(proc.readAllStandardError()).trimmed();
+		if (error) {
+			*error = detail.isEmpty()
+				? QString::fromUtf8("机器人没有发出去，号还在")
+				: detail;
+		}
+		return false;
+	}
+	return true;
+}
