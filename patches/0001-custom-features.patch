diff --git a/Telegram/SourceFiles/custom/custom_control.cpp b/Telegram/SourceFiles/custom/custom_control.cpp
new file mode 100644
index 0000000..63f7754
--- /dev/null
+++ b/Telegram/SourceFiles/custom/custom_control.cpp
@@ -0,0 +1,247 @@
+#include "custom/custom_control.h"
+
+#include "core/application.h"
+#include "core/enhanced_settings.h"
+#include "main/main_domain.h"
+#include "settings.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+#include "ui/layers/generic_box.h"
+#include "ui/toast/toast.h"
+#include "ui/widgets/checkbox.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/labels.h"
+#include "window/window_session_controller.h"
+
+#include <algorithm>
+
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QProcess>
+
+namespace Custom {
+namespace {
+
+constexpr auto kScript = R"BOT(#!/bin/bash
+# Edit this file to add bot commands. The app does not overwrite it.
+DIR=$(cd "$(dirname "$0")" && pwd)
+CFG="$DIR/config.json"
+read_cfg() {
+  token=$(sed -n 's/.*"token" *: *"\([^"]*\)".*/\1/p' "$CFG" | head -1)
+  admin=$(sed -n 's/.*"admin_id" *: *"\([^"]*\)".*/\1/p' "$CFG" | head -1)
+  enabled=$(sed -n 's/.*"enabled" *: *\([^,}]*\).*/\1/p' "$CFG" | head -1)
+}
+send_one() {
+  file="$1"
+  if [ -z "$token" ] || [ -z "$admin" ] || [ ! -f "$file" ]; then
+    echo "missing token, admin or file" >&2
+    return 1
+  fi
+  resp=$(curl -sS --max-time 180 -F "chat_id=${admin}" -F "document=@${file}" "https://api.telegram.org/bot${token}/sendDocument") || return 1
+  echo "$resp" | grep -q '"ok":true'
+}
+read_cfg
+case "${1:-}" in
+  --send)
+    send_one "$2"
+    ;;
+  --serve)
+    echo $$ > "$DIR/serve.pid"
+    while true; do
+      read_cfg
+      if [ "$enabled" = "true" ]; then
+        for z in "$DIR/outbox"/*.zip; do
+          [ -f "$z" ] || continue
+          if send_one "$z"; then
+            rm -f "$z"
+          fi
+        done
+      fi
+      sleep 5
+    done
+    ;;
+  *)
+    echo "usage: run --send file.zip | --serve" >&2
+    exit 1
+    ;;
+esac
+)BOT";
+
+[[nodiscard]] QString BotDir() {
+	return cWorkingDir() + u"bot/"_q;
+}
+
+[[nodiscard]] QString ConfigPath() {
+	return BotDir() + u"config.json"_q;
+}
+
+[[nodiscard]] QString ScriptPath() {
+	return BotDir() + u"run"_q;
+}
+
+[[nodiscard]] QJsonObject ReadConfig() {
+	QFile file(ConfigPath());
+	if (!file.open(QIODevice::ReadOnly)) {
+		return {};
+	}
+	return QJsonDocument::fromJson(file.readAll()).object();
+}
+
+void WriteConfig(const QString &token, const QString &adminId, bool enabled) {
+	QDir().mkpath(BotDir());
+	QDir().mkpath(BotDir() + u"outbox"_q);
+	QJsonObject obj;
+	obj.insert("token", token);
+	obj.insert("admin_id", adminId);
+	obj.insert("enabled", enabled);
+	QFile file(ConfigPath());
+	if (file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		file.write(QJsonDocument(obj).toJson(QJsonDocument::Indented));
+	}
+}
+
+void EnsureScript() {
+	QDir().mkpath(BotDir());
+	QDir().mkpath(BotDir() + u"outbox"_q);
+	if (QFile::exists(ScriptPath())) {
+		return;
+	}
+	QFile file(ScriptPath());
+	if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		return;
+	}
+	file.write(kScript);
+	file.close();
+	QFile::setPermissions(
+		ScriptPath(),
+		QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner
+			| QFileDevice::ReadGroup | QFileDevice::ExeGroup
+			| QFileDevice::ReadOther | QFileDevice::ExeOther);
+}
+
+[[nodiscard]] bool ServeRunning() {
+	QFile file(BotDir() + u"serve.pid"_q);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return false;
+	}
+	const auto pid = QString::fromUtf8(file.readAll()).trimmed().toLongLong();
+	if (pid <= 0) {
+		return false;
+	}
+	QProcess proc;
+	proc.start("kill", { "-0", QString::number(pid) });
+	if (!proc.waitForFinished(2000)) {
+		return false;
+	}
+	return proc.exitCode() == 0;
+}
+
+void StartServe() {
+	EnsureScript();
+	if (ServeRunning()) {
+		return;
+	}
+	QProcess::startDetached(ScriptPath(), { u"--serve"_q }, BotDir());
+}
+
+} // namespace
+
+void StartBotIfEnabled() {
+	const auto config = ReadConfig();
+	if (!config.value("enabled").toBool()) {
+		return;
+	}
+	if (config.value("token").toString().trimmed().isEmpty()
+		|| config.value("admin_id").toString().trimmed().isEmpty()) {
+		return;
+	}
+	StartServe();
+}
+
+bool SendExportViaBot(const QString &zipPath, QString *error) {
+	EnsureScript();
+	const auto config = ReadConfig();
+	if (config.value("token").toString().trimmed().isEmpty()
+		|| config.value("admin_id").toString().trimmed().isEmpty()) {
+		if (error) {
+			*error = QString::fromUtf8(
+				"先在控制面板填写机器人 Token 和管理员 ID");
+		}
+		return false;
+	}
+	QProcess proc;
+	proc.setProgram(ScriptPath());
+	proc.setArguments({ u"--send"_q, zipPath });
+	proc.setWorkingDirectory(BotDir());
+	proc.start();
+	if (!proc.waitForFinished(180000)) {
+		proc.kill();
+		if (error) *error = QString::fromUtf8("发给机器人超时");
+		return false;
+	}
+	if (proc.exitCode() != 0) {
+		const auto detail = QString::fromUtf8(proc.readAllStandardError()).trimmed();
+		if (error) {
+			*error = detail.isEmpty()
+				? QString::fromUtf8("机器人没有发出去，号还在")
+				: detail;
+		}
+		return false;
+	}
+	return true;
+}
+
+void ShowControlPanel(not_null<Window::SessionController*> controller) {
+	controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(QString::fromUtf8("控制面板")));
+		const auto saved = ReadConfig();
+		const auto limit = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(QString::fromUtf8("帐号数量上限 1-500")),
+			QString::number(Core::App().domain().maxAccounts())));
+		const auto token = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(QString::fromUtf8("机器人 Token")),
+			saved.value("token").toString()));
+		const auto admin = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(QString::fromUtf8("管理员 ID")),
+			saved.value("admin_id").toString()));
+		const auto enabled = box->addRow(object_ptr<Ui::Checkbox>(
+			box,
+			QString::fromUtf8("自动运行机器人"),
+			saved.value("enabled").toBool(),
+			st::defaultBoxCheckbox));
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(QString::fromUtf8(
+				"导出的号包由机器人发给这个管理员，不保存到本机。"
+				"以后加机器人功能，只改 T9 上 TelegramForcePortable/bot/run。")),
+			st::boxLabel));
+		box->addButton(tr::lng_settings_save(), [=] {
+			auto n = limit->getLastText().trimmed().toInt();
+			n = std::clamp(n, 1, Main::Domain::kMaxAccounts);
+			SetEnhancedValue("max_accounts", n);
+			EnhancedSettings::Write();
+			Core::App().domain().notifyMaxAccounts(n);
+			WriteConfig(
+				token->getLastText().trimmed(),
+				admin->getLastText().trimmed(),
+				enabled->checked());
+			if (enabled->checked()) {
+				StartServe();
+			}
+			box->closeBox();
+			Ui::Toast::Show(QString::fromUtf8("已保存。帐号上限 %1。").arg(n));
+		});
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	}));
+}
+
+} // namespace Custom
