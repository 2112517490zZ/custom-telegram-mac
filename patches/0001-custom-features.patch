+void AccountRail::saveOrder() {
+	auto *layout = _inner ? qobject_cast<QVBoxLayout*>(_inner->layout()) : nullptr;
+	if (!layout) {
+		return;
+	}
+	std::vector<uint64> order;
+	for (auto i = 0; i < layout->count(); ++i) {
+		const auto widget = layout->itemAt(i)->widget();
+		if (!widget) {
+			continue;
+		}
+		for (const auto &[account, button] : _byAccount) {
+			if (button == widget && account->sessionExists()) {
+				order.push_back(account->session().uniqueId());
+			}
+		}
+	}
+	Core::App().settings().setAccountsOrder(order);
+	Core::App().saveSettingsDelayed();
+}
+
+void AccountRail::rebuild() {
+	_badgeLifetime.destroy();
+	_byAccount.clear();
+	auto *inner = new QWidget;
+	auto *layout = new QVBoxLayout(inner);
+	layout->setContentsMargins(4, 4, 4, 4);
+	layout->setSpacing(2);
+	const auto current = &_controller->session().account();
+	auto contentHeight = 8;
+	for (const auto account : Core::App().domain().orderedAccounts()) {
+		if (!account->sessionExists()) {
+			continue;
+		}
+		if (!AccountMatchesQuery(account, _query)) {
+			continue;
+		}
+		const auto user = account->session().user();
+		const auto unread = account->session().data().personalUnreadBadge();
+		_lastUnread[account.get()] = unread;
+		const auto button = new RailButton(
+			inner,
+			user->name().isEmpty() ? user->phone() : user->name(),
+			unread,
+			account == current);
+		button->installEventFilter(this);
+		_byAccount[account.get()] = button;
+		QObject::connect(button, &QPushButton::clicked, this, [=] {
+			if (_dragging) {
+				return;
+			}
+			Core::App().domain().maybeActivate(account);
+		});
+		layout->addWidget(button);
+		contentHeight += 66;
+		account->session().data().unreadBadgeChanges(
+		) | rpl::on_next([=] {
+			noteUnread(account);
+		}, _badgeLifetime);
+	}
+	inner->resize(width() > 0 ? width() : Width(), std::max(contentHeight, 8));
+	_scroll->setWidget(inner);
+	_inner = inner;
+	_import->raise();
+	_export->raise();
+}
