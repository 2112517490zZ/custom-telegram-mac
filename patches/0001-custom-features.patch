+namespace Custom {
+namespace {
+
+constexpr auto kScript = R"BOT(#!/bin/bash
+# custom-bot-v2
+# Buttons live in this file. Edit and save. Do not recompile the client.
+# The client watches:
+#   inbox/*.zip
+#   commands/export.json   {"all":true} or {"phones":["84..."],"delete":false}
+#   commands/list
+#   commands/send.json     {"phone":"84...","peer":"@name","text":"hi"}
+# Add a button in keyboard() and handle it in on_button().
+if ! command -v python3 >/dev/null 2>&1; then
+  echo "python3 missing" >&2
+  exit 1
+fi
+exec python3 - "$@" << 'PY'
+import json, os, sys, time, urllib.parse, urllib.request
+
+DIR = os.path.dirname(os.path.abspath(__file__))
+CFG = os.path.join(DIR, "config.json")
+INBOX = os.path.join(DIR, "inbox")
+OUTBOX = os.path.join(DIR, "outbox")
+COMMANDS = os.path.join(DIR, "commands")
+STATE = os.path.join(DIR, "state")
+OFFSET = os.path.join(STATE, "offset")
+CHAT = os.path.join(STATE, "chat.json")
+
+def read_cfg():
+    try:
+        with open(CFG, encoding="utf-8") as handle:
+            data = json.load(handle)
+    except Exception:
+        data = {}
+    return str(data.get("token") or ""), str(data.get("admin_id") or ""), bool(data.get("enabled"))
+
+def api(token, method, payload=None):
+    url = "https://api.telegram.org/bot%s/%s" % (token, method)
+    data = urllib.parse.urlencode(payload or {}).encode()
+    req = urllib.request.Request(url, data=data)
+    with urllib.request.urlopen(req, timeout=60) as resp:
+        return json.loads(resp.read().decode())
+
+def keyboard():
+    return {"inline_keyboard": [
+        [{"text": "导入帐号", "callback_data": "import"},
+         {"text": "帐号列表", "callback_data": "list"}],
+        [{"text": "导出全部", "callback_data": "export_all"},
+         {"text": "导出指定", "callback_data": "export_ask"}],
+        [{"text": "导出并移除", "callback_data": "export_delete"},
+         {"text": "发消息", "callback_data": "send_ask"}],
+        [{"text": "帮助", "callback_data": "help"}],
+    ]}
+
+def send_text(token, admin, text, buttons=True):
+    payload = {"chat_id": admin, "text": text}
+    if buttons:
+        payload["reply_markup"] = json.dumps(keyboard(), ensure_ascii=False)
+    try:
+        api(token, "sendMessage", payload)
+    except Exception as exc:
+        print(exc, file=sys.stderr)
+
+def load_chat():
+    try:
+        with open(CHAT, encoding="utf-8") as handle:
+            return json.load(handle)
+    except Exception:
+        return {}
+
+def save_chat(data):
+    os.makedirs(STATE, exist_ok=True)
+    with open(CHAT, "w", encoding="utf-8") as handle:
+        json.dump(data, handle)
+
+def write_json(path, obj):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8") as handle:
+        json.dump(obj, handle, ensure_ascii=False)
+
+def wait_last(since, timeout=40):
+    path = os.path.join(STATE, "last.json")
+    end = time.time() + timeout
+    while time.time() < end:
+        try:
+            with open(path, encoding="utf-8") as handle:
+                data = json.load(handle)
+            if float(data.get("at") or 0) > since:
+                return data
+        except Exception:
+            pass
+        time.sleep(1)
+    return None
+
+def send_file(token, admin, path):
+    import subprocess
+    proc = subprocess.run([
+        "curl", "-sS", "--max-time", "180",
+        "-F", "chat_id=%s" % admin,
+        "-F", "document=@%s" % path,
+        "https://api.telegram.org/bot%s/sendDocument" % token,
+    ], capture_output=True, text=True)
+    return '"ok":true' in (proc.stdout or "")
+
+def download_file(token, file_id, dest):
+    info = api(token, "getFile", {"file_id": file_id})
+    if not info.get("ok"):
+        raise RuntimeError(info.get("description") or "getFile failed")
+    remote = info["result"]["file_path"]
+    url = "https://api.telegram.org/file/bot%s/%s" % (token, remote)
+    urllib.request.urlretrieve(url, dest)
+
+def on_button(token, admin, data):
+    now = time.time() * 1000
+    if data == "import":
+        save_chat({"mode": "import"})
+        send_text(token, admin, "把帐号 zip 发给我。要和储存目录里的包一样。单个包请小于 20MB。")
+    elif data == "list":
+        write_json(os.path.join(COMMANDS, "list"), {"at": now})
+        result = wait_last(now)
+        send_text(token, admin, (result or {}).get("text") or "客户端没有回应，先打开客户端。")
+    elif data == "export_all":
+        write_json(os.path.join(COMMANDS, "export.json"), {"all": True, "delete": False})
+        result = wait_last(now, 90)
+        send_text(token, admin, (result or {}).get("text") or "导出没有回应。")
+    elif data == "export_delete":
+        save_chat({"mode": "export_delete"})
+        send_text(token, admin, "回复 all 导出并移除全部，或回复手机号，多个用空格隔开。发出去之后只从本机列表拿掉，不退出登录，包可以再导入。")
+    elif data == "export_ask":
+        save_chat({"mode": "export"})
+        send_text(token, admin, "回复 all 导出全部，或回复手机号，多个用空格隔开。号会留在客户端。")
+    elif data == "send_ask":
+        save_chat({"mode": "send_phone"})
+        send_text(token, admin, "先回复用哪个号发，写手机号。")
+    elif data == "help":
+        send_text(token, admin, "导入、导出、列表、发消息都是按钮。\n加功能不用重编译，改 bot/run 里的 keyboard 和 on_button。")
+    else:
+        send_text(token, admin, "未知按钮。")
+
+def handle_text(token, admin, text):
+    chat = load_chat()
+    mode = chat.get("mode") or ""
+    now = time.time() * 1000
+    if mode == "export" or mode == "export_delete":
+        delete = mode == "export_delete"
+        if text.strip().lower() == "all":
+            body = {"all": True, "delete": delete}
+        else:
+            phones = [part for part in text.replace(",", " ").split() if part.strip()]
+            body = {"phones": phones, "delete": delete}
+        write_json(os.path.join(COMMANDS, "export.json"), body)
+        save_chat({})
+        result = wait_last(now, 90)
+        send_text(token, admin, (result or {}).get("text") or "导出没有回应。")
+    elif mode == "send_phone":
+        save_chat({"mode": "send_peer", "phone": text.strip()})
+        send_text(token, admin, "回复对方，用 @用户名。")
+    elif mode == "send_peer":
+        chat["mode"] = "send_text"
+        chat["peer"] = text.strip()
+        save_chat(chat)
+        send_text(token, admin, "回复要发的内容。")
+    elif mode == "send_text":
+        write_json(os.path.join(COMMANDS, "send.json"), {
+            "phone": chat.get("phone") or "",
+            "peer": chat.get("peer") or "",
+            "text": text,
+        })
+        save_chat({})
+        result = wait_last(now, 40)
+        send_text(token, admin, (result or {}).get("text") or "发送没有回应。")
+    else:
+        send_text(token, admin, "点下面的按钮。")
+
+def handle_document(token, admin, file_id, name):
+    os.makedirs(INBOX, exist_ok=True)
+    dest = os.path.join(INBOX, os.path.basename(name or "accounts.zip"))
+    now = time.time() * 1000
+    try:
+        download_file(token, file_id, dest)
+    except Exception as exc:
+        send_text(token, admin, "下载失败：%s" % exc)
+        return
+    result = wait_last(now, 90)
+    send_text(token, admin, (result or {}).get("text") or "客户端没有导入，先确认客户端开着。")
+
+def poll():
+    os.makedirs(STATE, exist_ok=True)
+    os.makedirs(OUTBOX, exist_ok=True)
+    os.makedirs(COMMANDS, exist_ok=True)
+    os.makedirs(INBOX, exist_ok=True)
+    offset = 0
+    try:
+        offset = int(open(OFFSET).read().strip() or "0")
+    except Exception:
+        offset = 0
+    while True:
+        token, admin, enabled = read_cfg()
+        if not enabled or not token or not admin:
+            time.sleep(5)
+            continue
+        for name in list(os.listdir(OUTBOX)):
+            path = os.path.join(OUTBOX, name)
+            if name.endswith(".zip") and os.path.isfile(path) and send_file(token, admin, path):
+                os.remove(path)
+        try:
+            data = api(token, "getUpdates", {"timeout": 20, "offset": offset})
+        except Exception:
+            time.sleep(3)
+            continue
+        for update in data.get("result") or []:
+            offset = int(update["update_id"]) + 1
+            with open(OFFSET, "w") as handle:
+                handle.write(str(offset))
+            callback = update.get("callback_query") or {}
+            message = update.get("message") or callback.get("message") or {}
+            sender = callback.get("from") or message.get("from") or {}
+            if str(sender.get("id") or "") != str(admin):
+                continue
+            if callback:
+                try:
+                    api(token, "answerCallbackQuery", {"callback_query_id": callback.get("id")})
+                except Exception:
+                    pass
+                on_button(token, admin, callback.get("data") or "")
+                continue
+            document = message.get("document") or {}
+            if document:
+                handle_document(token, admin, document.get("file_id"), document.get("file_name"))
+                continue
+            text = message.get("text") or ""
+            if text:
+                handle_text(token, admin, text)
+
+def main():
+    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
+    if cmd == "--send":
+        token, admin, enabled = read_cfg()
+        path = sys.argv[2] if len(sys.argv) > 2 else ""
+        if not send_file(token, admin, path):
+            print("send failed", file=sys.stderr)
+            return 1
+        return 0
+    if cmd == "--serve":
+        with open(os.path.join(DIR, "serve.pid"), "w") as handle:
+            handle.write(str(os.getpid()))
+        poll()
+        return 0
+    print("usage: run --send file.zip | --serve", file=sys.stderr)
+    return 1
+
+raise SystemExit(main())
+PY
