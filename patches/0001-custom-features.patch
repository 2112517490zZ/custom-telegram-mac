+void SearchPanel::dropEvent(QDropEvent *e) {
+	if (TryImportDroppedZip(
+			e->mimeData(),
+			&_controller->session().domain())) {
+		e->acceptProposedAction();
+	}
+}
+
+bool SearchPanel::matchFilter(not_null<PeerData*> peer) const {
+	switch (_filter) {
+	case Filter::All: return true;
+	case Filter::User: return peer->isUser() && !peer->isBot();
+	case Filter::Group: return peer->isChat() || peer->isMegagroup();
+	case Filter::Channel: return peer->isBroadcast();
+	case Filter::Bot: return peer->isUser() && peer->isBot();
+	}
+	return true;
+}
+
+void SearchPanel::requestSearch() {
+	if (_text.isEmpty()) {
+		return;
+	}
+	auto &api = _controller->session().api();
+	if (_requestId) {
+		api.request(base::take(_requestId)).cancel();
+	}
+	using Flag = MTPmessages_SearchGlobal::Flag;
+	auto flags = Flag::f_folder_id;
+	if (_filter == Filter::User || _filter == Filter::Bot) {
+		flags |= Flag::f_users_only;
+	} else if (_filter == Filter::Group) {
+		flags |= Flag::f_groups_only;
+	} else if (_filter == Filter::Channel) {
+		flags |= Flag::f_broadcasts_only;
+	}
+	_hint->setText(QString::fromUtf8("搜索中…"));
+	_requestId = api.request(MTPmessages_SearchGlobal(
+		MTP_flags(flags),
+		MTP_int(0),
+		MTPInputChannel(),
+		MTP_string(_text),
+		MTP_inputMessagesFilterEmpty(),
+		MTP_int(0),
+		MTP_int(0),
+		MTP_int(0),
+		MTP_inputPeerEmpty(),
+		MTP_int(0),
+		MTP_int(50)
+	)).done([=](const MTPmessages_Messages &result) {
+		_requestId = 0;
+		applyResult(result);
+	}).fail([=] {
+		_requestId = 0;
+		_hint->setText(QString::fromUtf8("搜索失败"));
+	}).send();
+}
+
+void SearchPanel::applyResult(const MTPmessages_Messages &result) {
+	auto &owner = _controller->session().data();
+	_list->clear();
+	_hits.clear();
+
+	const auto consume = [&](const auto &data) {
+		owner.processUsers(data.vusers());
+		owner.processChats(data.vchats());
+		for (const auto &message : data.vmessages().v) {
+			const auto item = owner.addNewMessage(
+				message,
+				MessageFlags(),
+				NewMessageType::Existing);
+			if (!item) {
+				continue;
+			}
+			const auto peer = item->history()->peer;
+			if (!matchFilter(peer)) {
+				continue;
+			}
+			_hits.push_back(item->fullId());
+			const auto snippet = item->notificationText().text;
+			_list->addItem(peer->name()
+				+ u"  ["_q
+				+ KindLabel(peer)
+				+ u"]\n"_q
+				+ snippet);
+		}
+	};
+	result.match([&](const MTPDmessages_messages &data) {
+		consume(data);
+	}, [&](const MTPDmessages_messagesSlice &data) {
+		consume(data);
+	}, [&](const MTPDmessages_channelMessages &data) {
+		consume(data);
+	}, [&](const MTPDmessages_messagesNotModified &) {
+	});
+	_hint->setText(QString::fromUtf8("底部结果 · %1 条").arg(_hits.size()));
+}
+
+void SearchPanel::openRow(int row) {
+	if (row < 0 || row >= int(_hits.size())) {
+		return;
+	}
+	const auto id = _hits[row];
+	const auto item = _controller->session().data().message(id);
+	if (!item) {
+		return;
+	}
+	_controller->showPeerHistory(
+		item->history()->peer,
+		Window::SectionShow::Way::Forward,
+		item->fullId().msg);
+}
+
+} // namespace Custom
