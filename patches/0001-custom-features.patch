+	static auto started = false;
+	if (started) {
+		return;
+	}
+	started = true;
+	const auto timer = new QTimer(QCoreApplication::instance());
+	timer->setInterval(2000);
+	QObject::connect(timer, &QTimer::timeout, [] { PollBotCommands(); });
+	timer->start();
+}
