+bool ZipChildren(const QString &folder, const QString &zipPath) {
+	QFile::remove(zipPath);
+	auto names = QDir(folder).entryList(
+		QDir::Dirs | QDir::Files | QDir::NoDotAndDotDot);
+	if (names.isEmpty()) {
+		return false;
+	}
+	QProcess proc;
+	proc.setProgram("zip");
+	proc.setWorkingDirectory(folder);
+	auto args = QStringList{ u"-qr"_q, zipPath };
+	args.append(names);
+	proc.setArguments(args);
+	proc.start();
+	if (!proc.waitForFinished(10 * 60 * 1000)) {
+		proc.kill();
+		return false;
+	}
+	return proc.exitCode() == 0 && QFile::exists(zipPath);
+}
+
+[[nodiscard]] QString TelethonString(qint32 dcId, const QByteArray &authKey) {
+	if (dcId < 1 || dcId > 5 || authKey.size() != 256) {
+		return {};
+	}
+	static const auto kHost = std::array<const char*, 6>{
+		"",
+		"149.154.175.53",
+		"149.154.167.51",
+		"149.154.175.100",
+		"149.154.167.91",
+		"91.108.56.165",
+	};
+	const auto parts = QString::fromLatin1(kHost[dcId]).split('.');
+	if (parts.size() != 4) {
+		return {};
+	}
+	QByteArray packed;
+	packed.append(char(dcId));
+	for (const auto &part : parts) {
+		packed.append(char(part.toInt()));
+	}
+	packed.append(char(0x01));
+	packed.append(char(0xBB));
+	packed.append(authKey);
+	return u"1"_q + QString::fromLatin1(
+		packed.toBase64(QByteArray::Base64UrlEncoding));
+}
