+	connect(_search, &QLineEdit::textChanged, this, [=](const QString &text) {
+		_query = text.trimmed();
+		rebuild();
+	});
+	connect(_add, &QPushButton::clicked, this, [=] {
+		showLoginSheet();
+	});
+	connect(_import, &QPushButton::clicked, this, [=] {
+		showLoginSheet();
+	});
+	connect(_export, &QPushButton::clicked, this, [=] {
+		crl::on_main(this, [=] {
+			ChooseAndExportAccounts(_controller);
+		});
+	});
+	connect(_bounce, &QTimer::timeout, this, [=] { tickBounce(); });
+
+	Core::App().domain().accountsChanges(
+	) | rpl::on_next([=] {
+		scheduleRebuild();
+	}, lifetime());
+	rebuild();
+}
+
+void AccountRail::showLoginSheet() {
+	if (_importChoices) {
+		_importChoices->deleteLater();
+		_importChoices = nullptr;
+		return;
+	}
+	auto *host = _controller->widget().get();
+	auto *sheet = CreateLoginSheet(host);
+	_importChoices = sheet;
+	connect(sheet, &QObject::destroyed, this, [=] {
+		if (_importChoices == sheet) {
+			_importChoices = nullptr;
+		}
+	});
+	sheet->show();
+	placeLoginSheet();
+}
+
+void AccountRail::placeLoginSheet() {
+	if (!_importChoices) {
+		return;
+	}
+	const auto host = _controller->widget().get();
+	_importChoices->setGeometry(
+		std::max(0, (host->width() - 400) / 2),
+		std::max(0, (host->height() - 680) / 2),
+		400,
+		680);
+	_importChoices->raise();
+}
+
+void AccountRail::scheduleRebuild() {
+	if (_rebuildQueued) {
+		return;
+	}
+	_rebuildQueued = true;
+	crl::on_main(this, [=] {
+		_rebuildQueued = false;
+		rebuild();
+	});
+}
+
+void AccountRail::noteUnread(not_null<Main::Account*> account) {
+	if (!account->sessionExists()) {
+		return;
+	}
+	const auto now = account->session().data().personalUnreadBadge();
+	const auto previous = _lastUnread[account.get()];
+	_lastUnread[account.get()] = now;
+	if (const auto widget = _byAccount[account.get()]) {
+		static_cast<RailButton*>(widget)->setUnread(now);
+	}
+	if (now > previous) {
+		_bounceAt[account.get()] = QDateTime::currentMSecsSinceEpoch();
+		if (!_bounce->isActive()) {
+			_bounce->start(40);
+		}
+	}
+}
+
+void AccountRail::tickBounce() {
+	const auto now = QDateTime::currentMSecsSinceEpoch();
+	auto alive = false;
+	for (auto &[account, started] : _bounceAt) {
+		const auto widget = _byAccount[account];
+		if (!widget) {
+			continue;
+		}
+		const auto elapsed = now - started;
+		if (elapsed > 1200) {
+			static_cast<RailButton*>(widget)->setHop(0);
+			continue;
+		}
+		alive = true;
+		const auto hop = int(std::sin(elapsed / 140.0) * 6);
+		static_cast<RailButton*>(widget)->setHop(std::abs(hop));
+	}
+	if (!alive) {
+		_bounce->stop();
+		_bounceAt.clear();
+	}
+}
+
+void AccountRail::saveOrder() {
+	auto *layout = _inner ? qobject_cast<QVBoxLayout*>(_inner->layout()) : nullptr;
+	if (!layout) {
+		return;
+	}
+	std::vector<uint64> order;
+	for (auto i = 0; i < layout->count(); ++i) {
+		const auto widget = layout->itemAt(i)->widget();
+		if (!widget) {
+			continue;
+		}
+		for (const auto &[account, button] : _byAccount) {
+			if (button == widget && account->sessionExists()) {
+				order.push_back(account->session().uniqueId());
+			}
+		}
+	}
+	Core::App().settings().setAccountsOrder(order);
+	Core::App().saveSettingsDelayed();
+}
+
+void AccountRail::rebuild() {
+	if (_rebuilding) {
+		scheduleRebuild();
+		return;
+	}
+	_rebuilding = true;
+	_badgeLifetime.destroy();
+	_byAccount.clear();
+	auto *inner = new QWidget;
+	auto *layout = new QVBoxLayout(inner);
+	layout->setContentsMargins(4, 4, 4, 4);
+	layout->setSpacing(2);
+	const auto current = &_controller->session().account();
+	auto contentHeight = 8;
+	for (const auto account : Core::App().domain().orderedAccounts()) {
+		if (!account->sessionExists()) {
+			continue;
+		}
+		if (!AccountMatchesQuery(account, _query)) {
+			continue;
+		}
+		const auto user = account->session().user();
+		const auto unread = account->session().data().personalUnreadBadge();
+		_lastUnread[account.get()] = unread;
+		auto label = user->name();
+		if (label.isEmpty()) {
+			label = user->phone();
+		}
+		if (label.isEmpty()) {
+			label = QString::number(peerToUser(user->id).bare);
+		}
+		const auto button = new RailButton(
+			inner,
+			label,
+			unread,
+			account == current);
+		button->installEventFilter(this);
+		_byAccount[account.get()] = button;
+		QObject::connect(button, &QPushButton::clicked, this, [=] {
+			if (_dragging) {
+				return;
+			}
+			Core::App().domain().maybeActivate(account);
+		});
+		layout->addWidget(button);
+		contentHeight += 66;
+		account->session().data().unreadBadgeChanges(
+		) | rpl::on_next([=] {
+			noteUnread(account);
+		}, _badgeLifetime);
+	}
+	inner->resize(width() > 0 ? width() : Width(), std::max(contentHeight, 8));
+	_scroll->setWidget(inner);
+	_inner = inner;
+	_add->raise();
+	_import->raise();
+	_export->raise();
+	_rebuilding = false;
+}
+
+bool AccountRail::eventFilter(QObject *watched, QEvent *event) {
+	const auto button = qobject_cast<QWidget*>(watched);
+	if (!button || !_inner || !_inner->layout()) {
+		return false;
+	}
+	auto known = false;
+	for (const auto &[account, widget] : _byAccount) {
+		if (widget == button) {
+			known = true;
+			break;
+		}
+	}
+	if (!known) {
+		return false;
+	}
+	if (event->type() == QEvent::MouseButtonPress) {
+		const auto mouse = static_cast<QMouseEvent*>(event);
+		if (mouse->button() == Qt::LeftButton) {
+			_pressButton = button;
+			_pressY = mouse->globalPos().y();
+			_dragging = false;
+		}
+	} else if (event->type() == QEvent::MouseMove && _pressButton == button) {
+		const auto mouse = static_cast<QMouseEvent*>(event);
+		if (std::abs(mouse->globalPos().y() - _pressY) < 12) {
+			return false;
+		}
+		_dragging = true;
+		auto *layout = qobject_cast<QVBoxLayout*>(_inner->layout());
+		const auto from = layout->indexOf(button);
+		const auto localY = _inner->mapFromGlobal(mouse->globalPos()).y();
+		auto to = 0;
+		auto widgets = 0;
+		for (auto i = 0; i < layout->count(); ++i) {
+			const auto widget = layout->itemAt(i)->widget();
+			if (!widget) {
+				continue;
+			}
+			++widgets;
+			if (localY > widget->geometry().center().y()) {
+				to = widgets - 1;
+			}
+		}
+		if (from >= 0 && to >= 0 && from != to) {
+			layout->removeWidget(button);
+			layout->insertWidget(to, button);
+		}
+		return true;
+	} else if (event->type() == QEvent::MouseButtonRelease && _pressButton == button) {
+		const auto dragged = _dragging;
+		_pressButton = nullptr;
+		if (dragged) {
+			saveOrder();
+			_dragging = false;
+			return true;
+		}
+	}
+	return false;
+}
+
+void AccountRail::resizeEvent(QResizeEvent *e) {
+	_search->setGeometry(6, 8, width() - 12, 28);
+	const auto buttonH = 28;
+	const auto gap = 4;
+	auto y = height() - 6 - buttonH;
+	const auto place = [&](QPushButton *button) {
+		button->setGeometry(6, y, width() - 12, buttonH);
+		y -= buttonH + gap;
+	};
+	place(_export);
+	place(_import);
+	place(_add);
+	const auto listHeight = std::max(0, y - 42);
+	_scroll->setGeometry(0, 42, width(), listHeight);
+	if (_inner) {
+		_inner->setFixedWidth(width());
+	}
+	_add->raise();
+	_import->raise();
+	_export->raise();
+	_search->raise();
+	placeLoginSheet();
+}
+
+void AccountRail::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.fillRect(rect(), QColor(41, 58, 76));
+}
+
+void AccountRail::dragEnterEvent(QDragEnterEvent *e) {
+	if (!ZipPathsFromMime(e->mimeData()).isEmpty()) {
+		e->setDropAction(Qt::CopyAction);
+		e->accept();
+	}
+}
+
+void AccountRail::dropEvent(QDropEvent *e) {
+	if (TryImportDroppedZip(
+			e->mimeData(),
+			&_controller->session().domain())) {
+		e->acceptProposedAction();
+	}
+}
+
+} // namespace Custom
