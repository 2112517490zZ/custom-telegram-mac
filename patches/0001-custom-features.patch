+[[nodiscard]] QByteArray ReadFileBytes(const QString &path) {
+	QFile f(path);
+	if (!f.open(QIODevice::ReadOnly)) {
+		return {};
+	}
+	return f.readAll();
+}
+
+[[nodiscard]] quint64 JsonUserId(const QJsonObject &o) {
+	const auto v = o.contains("user_id") ? o.value("user_id") : o.value("id");
+	if (v.isString()) {
+		return v.toString().trimmed().toULongLong();
+	}
+	if (v.isDouble()) {
+		return quint64(v.toDouble());
+	}
+	return 0;
+}
+
+bool ReadTelethonSession(
+		const QString &sessionPath,
+		qint32 *dcId,
+		QByteArray *authKey,
+		quint64 *userId = nullptr) {
+	sqlite3 *db = nullptr;
+	const auto utf8 = QDir::toNativeSeparators(sessionPath).toUtf8();
+	if (sqlite3_open_v2(
+			utf8.constData(),
+			&db,
+			SQLITE_OPEN_READONLY,
+			nullptr) != SQLITE_OK) {
+		if (db) {
+			sqlite3_close(db);
+		}
+		return false;
+	}
+	sqlite3_stmt *stmt = nullptr;
+	const auto sql = "SELECT dc_id, auth_key FROM sessions LIMIT 1";
+	auto ok = false;
+	if (sqlite3_prepare_v2(db, sql, -1, &stmt, nullptr) == SQLITE_OK) {
+		if (sqlite3_step(stmt) == SQLITE_ROW) {
+			*dcId = sqlite3_column_int(stmt, 0);
+			const auto blob = sqlite3_column_blob(stmt, 1);
+			const auto bytes = sqlite3_column_bytes(stmt, 1);
+			if (blob && bytes == 256) {
+				authKey->resize(256);
+				memcpy(authKey->data(), blob, 256);
+				ok = (*dcId > 0);
+			}
+		}
+		sqlite3_finalize(stmt);
+	}
+	if (ok && userId && *userId == 0) {
+		sqlite3_stmt *entity = nullptr;
+		const auto entitySql =
+			"SELECT id FROM entities WHERE id > 0 ORDER BY id LIMIT 1";
+		if (sqlite3_prepare_v2(db, entitySql, -1, &entity, nullptr)
+			== SQLITE_OK) {
+			if (sqlite3_step(entity) == SQLITE_ROW) {
+				*userId = quint64(sqlite3_column_int64(entity, 0));
+			}
+			sqlite3_finalize(entity);
+		}
+	}
+	sqlite3_close(db);
+	return ok;
+}
+
+bool ReadStringSession(
+		const QString &encoded,
+		qint32 *dcId,
+		QByteArray *authKey) {
+	auto s = encoded.trimmed();
+	if (s.isEmpty()) {
+		return false;
+	}
+	// Telethon puts a version character in front of the base64 payload.
+	if (s.size() > 20 && s.at(0) == QChar('1')) {
+		s.remove(0, 1);
+	}
+	auto data = QByteArray::fromBase64(
+		s.toUtf8(),
+		QByteArray::Base64UrlEncoding);
+	if (data.size() < 263) {
+		data = QByteArray::fromBase64(s.toUtf8());
+	}
+	if (data.size() == 264 || data.size() == 267) {
+		data = data.mid(1);
+	}
+	if (data.size() < 263) {
+		return false;
+	}
+	*dcId = int(uchar(data[0]));
+	*authKey = data.right(256);
+	return *dcId >= 1 && *dcId <= 5 && authKey->size() == 256;
+}
+
+bool CopyTree(const QString &src, const QString &dst) {
+	QDir().mkpath(dst);
+	QDirIterator it(
+		src,
+		QDir::Files | QDir::Dirs | QDir::NoDotAndDotDot,
+		QDirIterator::Subdirectories);
+	while (it.hasNext()) {
+		it.next();
+		const auto rel = QDir(src).relativeFilePath(it.filePath());
+		const auto target = dst + '/' + rel;
+		if (it.fileInfo().isDir()) {
+			QDir().mkpath(target);
+			continue;
+		}
+		QDir().mkpath(QFileInfo(target).absolutePath());
+		QFile::remove(target);
+		if (!QFile::copy(it.filePath(), target)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void ApplyKey(
+		ImportedAuth *out,
+		qint32 dcId,
+		quint64 userId,
+		const void *bytes,
+		int size) {
+	if (dcId <= 0 || !bytes || size != 256) {
+		return;
+	}
+	out->dcId = dcId;
+	out->userId = userId;
+	out->authKey = QByteArray(static_cast<const char*>(bytes), size);
+}
+
+bool TakeAuthFromStream(
+		QDataStream &stream,
+		int version,
+		ImportedAuth *out) {
+	auto context = Storage::details::ReadSettingsContext();
+	while (!stream.atEnd()) {
+		quint32 blockId = 0;
+		stream >> blockId;
+		if (stream.status() != QDataStream::Ok) {
+			break;
+		}
+		if (!Storage::details::ReadSetting(
+				blockId,
+				stream,
+				version,
+				context)) {
+			break;
+		}
+	}
+	if (!context.mtpAuthorization.isEmpty()) {
+		QDataStream auth(context.mtpAuthorization);
+		auth.setVersion(QDataStream::Qt_5_1);
+		const auto legacyUserId = Serialize::read<qint32>(auth);
+		const auto legacyMainDcId = Serialize::read<qint32>(auth);
+		auto userId = quint64();
+		auto mainDcId = qint32();
+		constexpr auto kWideIdsTag = ~quint64(0);
+		if (((quint64(legacyUserId) << 32) | quint64(legacyMainDcId))
+			== kWideIdsTag) {
+			userId = Serialize::read<quint64>(auth);
+			mainDcId = Serialize::read<qint32>(auth);
+		} else {
+			userId = quint64(legacyUserId);
+			mainDcId = legacyMainDcId;
+		}
+		const auto count = Serialize::read<qint32>(auth);
+		if (auth.status() != QDataStream::Ok || count < 0 || count > 32) {
+			return false;
+		}
+		for (auto i = 0; i != count; ++i) {
+			const auto dcId = Serialize::read<qint32>(auth);
+			const auto key = Serialize::read<MTP::AuthKey::Data>(auth);
+			if (auth.status() != QDataStream::Ok) {
+				return false;
+			}
+			if (dcId == mainDcId) {
+				ApplyKey(out, dcId, userId, key.data(), int(key.size()));
+				return out->authKey.size() == 256;
+			}
+		}
+		return false;
+	}
+	if (!context.mtpLegacyMainDcId || context.mtpLegacyUserId <= 0) {
+		return false;
+	}
+	for (const auto &key : context.mtpLegacyKeys) {
+		if (key && key->dcId() == context.mtpLegacyMainDcId) {
+			ApplyKey(
+				out,
+				context.mtpLegacyMainDcId,
+				quint64(context.mtpLegacyUserId),
+				key->data().data(),
+				int(key->data().size()));
+			return out->authKey.size() == 256;
+		}
+	}
+	return false;
+}
+
+// Desktop writes one account as "data", the next as "data#2", then "data#3".
+// The mtp file name is the first 8 bytes of MD5(that string), hex-encoded.
+QString OfficialDataName(int index) {
+	auto result = u"data"_q;
+	if (index > 0) {
+		result += '#' + QString::number(index + 1);
+	}
+	return result;
+}
+
+QString OfficialMtpFileName(int index) {
+	Storage::FileKey hash[2] = { 0 };
+	const auto utf8 = OfficialDataName(index).toUtf8();
+	hashMd5(utf8.constData(), utf8.size(), hash);
+	return Storage::details::ToFilePart(hash[0]);
+}
+
+bool ParseMtpSerialized(const QByteArray &serialized, ImportedAuth *out) {
+	QDataStream auth(serialized);
+	auth.setVersion(QDataStream::Qt_5_1);
+	const auto legacyUserId = Serialize::read<qint32>(auth);
+	const auto legacyMainDcId = Serialize::read<qint32>(auth);
+	auto userId = quint64();
+	auto mainDcId = qint32();
+	constexpr auto kWideIdsTag = ~quint64(0);
+	if (((quint64(legacyUserId) << 32) | quint64(legacyMainDcId))
+		== kWideIdsTag) {
+		userId = Serialize::read<quint64>(auth);
+		mainDcId = Serialize::read<qint32>(auth);
+	} else {
+		userId = quint64(legacyUserId);
+		mainDcId = legacyMainDcId;
+	}
+	const auto count = Serialize::read<qint32>(auth);
+	if (auth.status() != QDataStream::Ok || count < 0 || count > 32) {
+		return false;
+	}
+	for (auto i = 0; i != count; ++i) {
+		const auto dcId = Serialize::read<qint32>(auth);
+		const auto key = Serialize::read<MTP::AuthKey::Data>(auth);
+		if (auth.status() != QDataStream::Ok) {
+			return false;
+		}
+		if (dcId == mainDcId) {
+			ApplyKey(out, dcId, userId, key.data(), int(key.size()));
+			return out->authKey.size() == 256;
+		}
+	}
+	return false;
+}
+
+// readMtpData stores exactly one block: dbiMtpAuthorization + the serialized
+// key. Anything else is a settings map. Reading those maps calls into the
+// running app and aborts, so a file that does not start with this block is
+// skipped.
+bool ReadOneMtpFile(
+		const QString &base,
+		const QString &root,
+		const MTP::AuthKeyPtr &localKey,
+		ImportedAuth *out) {
+	using namespace Storage::details;
+	FileReadDescriptor file;
+	if (!ReadEncryptedFile(file, base, root, localKey)) {
+		return false;
+	}
+	auto blockId = quint32();
+	file.stream >> blockId;
+	if (file.stream.status() != QDataStream::Ok
+		|| blockId != dbiMtpAuthorization) {
+		return false;
+	}
+	auto serialized = QByteArray();
+	file.stream >> serialized;
+	if (file.stream.status() != QDataStream::Ok || serialized.isEmpty()) {
+		return false;
+	}
+	return ParseMtpSerialized(serialized, out);
+}
+
+bool ReadTdataAuths(
+		const QString &tdataDir,
+		std::vector<ImportedAuth> *out,
+		bool *locked) {
+	using namespace Storage::details;
+	QTemporaryDir copy;
+	if (!copy.isValid() || !CopyTree(tdataDir, copy.path())) {
+		return false;
+	}
+	// QTemporaryDir::path() has no trailing slash. ReadFile joins with
+	// the bare name, so "key_data" would become ".../xxxkey_datas".
+	auto root = copy.path();
+	if (!root.endsWith(u'/')) {
+		root += u'/';
+	}
+	FileReadDescriptor keyData;
+	if (!ReadFile(keyData, u"key_data"_q, root)
+		&& !ReadFile(keyData, u"key"_q, root)) {
+		return false;
+	}
+	// startModern: salt, local key encrypted with the desktop passcode,
+	// then the account index list encrypted with the local key.
+	QByteArray salt, keyEncrypted, infoEncrypted;
+	keyData.stream >> salt >> keyEncrypted >> infoEncrypted;
+	if (salt.size() != LocalEncryptSaltSize) {
+		return false;
+	}
+	const auto passcodeKey = CreateLocalKey(QByteArray(), salt);
+	EncryptedDescriptor keyInner;
+	if (!DecryptLocal(keyInner, keyEncrypted, passcodeKey)) {
+		if (locked) {
+			*locked = true;
+		}
+		return false;
+	}
+	const auto localBytes = Serialize::read<MTP::AuthKey::Data>(keyInner.stream);
+	if (keyInner.stream.status() != QDataStream::Ok) {
+		return false;
+	}
+	const auto localKey = std::make_shared<MTP::AuthKey>(localBytes);
+
+	auto bases = QStringList();
+	const auto addBase = [&](const QString &base) {
+		if (!base.isEmpty() && !bases.contains(base)) {
+			bases.push_back(base);
+		}
+	};
+	EncryptedDescriptor info;
+	if (!infoEncrypted.isEmpty()
+		&& DecryptLocal(info, infoEncrypted, localKey)) {
+		auto count = qint32();
+		info.stream >> count;
+		if (info.stream.status() == QDataStream::Ok
+			&& count > 0
+			&& count <= 256) {
+			for (auto i = 0; i != count; ++i) {
+				auto index = qint32();
+				info.stream >> index;
+				if (info.stream.status() != QDataStream::Ok) {
+					break;
+				}
+				if (index >= 0 && index < 256) {
+					addBase(OfficialMtpFileName(index));
+				}
+			}
+		}
+	}
+	if (bases.isEmpty()) {
+		addBase(OfficialMtpFileName(0));
+	}
+	// Exported packs rename that same mtp file to a fixed hash.
+	// Do not walk every other file. Those are settings maps, and feeding
+	// them to the settings reader aborts the running client.
+	addBase(u"D877F783D5D3EF8C"_q);
+	const auto listed = QDir(root).entryList(QDir::Files);
+	for (const auto &name : listed) {
+		auto base = name;
+		if (base.endsWith(u's') || base.endsWith(u'0') || base.endsWith(u'1')) {
+			base.chop(1);
+		}
+		if (base.size() == 16) {
+			addBase(base);
+		}
+	}
+	for (const auto &base : bases) {
+		auto one = ImportedAuth();
+		if (!ReadOneMtpFile(base, root, localKey, &one)) {
+			continue;
+		}
+		if (one.authKey.size() != 256) {
+			continue;
+		}
+		auto duplicate = false;
+		for (const auto &have : *out) {
+			if (one.userId != 0 && have.userId == one.userId) {
+				duplicate = true;
+				break;
+			}
+		}
+		if (!duplicate) {
+			out->push_back(one);
+		}
+	}
+	return !out->empty();
+}
+
+ImportedAuth ReadAccountFolder(const QString &folder) {
+	ImportedAuth result;
+	const auto name = QFileInfo(folder).fileName();
+	result.phone = name;
+
+	QDir dir(folder);
+	auto json = QJsonObject();
+	const auto jsonFiles = dir.entryList(QStringList() << "*.json", QDir::Files);
+	for (const auto &jsonName : jsonFiles) {
+		const auto doc = QJsonDocument::fromJson(
+			ReadFileBytes(dir.filePath(jsonName)));
+		if (!doc.isObject()) {
+			continue;
+		}
+		json = doc.object();
+		result.userId = JsonUserId(json);
+		result.phone = json.value("phone").toString(result.phone);
+		result.firstName = json.value("first_name").toString();
+		result.lastName = json.value("last_name").toString();
+		result.username = json.value("username").toString();
+		result.twoFa = json.value("twoFA").toString();
+		if (result.twoFa.isEmpty()) {
+			result.twoFa = json.value("twofa").toString();
+		}
+		if (result.twoFa.isEmpty()) {
+			result.twoFa = json.value("password").toString();
+		}
+		break;
+	}
+
+	for (const auto &twoName : { u"2fa.txt"_q, u"2FA.txt"_q }) {
+		const auto twoFaPath = dir.filePath(twoName);
+		if (!QFile::exists(twoFaPath)) {
+			continue;
+		}
+		const auto text = QString::fromUtf8(ReadFileBytes(twoFaPath)).trimmed();
+		if (!text.isEmpty()) {
+			result.twoFa = text;
+			break;
+		}
+	}
+
+	const auto sessions = dir.entryList(
+		QStringList() << "*.session",
+		QDir::Files);
+	for (const auto &sessionName : sessions) {
+		if (ReadTelethonSession(
+				dir.filePath(sessionName),
+				&result.dcId,
+				&result.authKey,
+				&result.userId)) {
+			break;
+		}
+	}
+
+	if (result.authKey.size() != 256 && !json.isEmpty()) {
+		const auto sessionString = json.value("session_string").toString();
+		if (sessionString.isEmpty()) {
+			ReadStringSession(
+				json.value("string_session").toString(),
+				&result.dcId,
+				&result.authKey);
+		} else {
+			ReadStringSession(sessionString, &result.dcId, &result.authKey);
+		}
+	}
+
+	if (result.authKey.size() != 256) {
+		const auto keyFiles = dir.entryList(
+			QStringList() << u"*密钥*"_q << u"*session_string*"_q,
+			QDir::Files);
+		for (const auto &keyName : keyFiles) {
+			const auto text = QString::fromUtf8(
+				ReadFileBytes(dir.filePath(keyName))).trimmed();
+			if (ReadStringSession(text, &result.dcId, &result.authKey)) {
+				break;
+			}
+		}
+	}
+
+	if (result.authKey.size() != 256 && !json.isEmpty()) {
+		const auto packed = QByteArray::fromBase64(
+			json.value("auth_key").toString().toUtf8());
+		if (packed.size() == 256) {
+			result.authKey = packed;
+			result.dcId = json.value("dc_id").toInt(result.dcId);
+		}
+	}
+
+	if (result.authKey.size() != 256) {
+		const auto tdata = dir.filePath("tdata");
+		auto many = std::vector<ImportedAuth>();
+		if (QDir(tdata).exists()
+			&& ReadTdataAuths(tdata, &many, nullptr)
+			&& !many.empty()) {
+			const auto userId = result.userId;
+			const auto phone = result.phone;
+			result = many.front();
+			if (!result.userId) {
+				result.userId = userId;
+			}
+			if (result.phone.isEmpty()) {
+				result.phone = phone;
+			}
+		}
+	}
+	if (result.dcId < 1 || result.dcId > 5) {
+		result.dcId = json.value("dc_id").toInt(2);
+	}
+	if (result.dcId < 1 || result.dcId > 5) {
+		result.dcId = 2;
+	}
+	return result;
+}
+
+void CollectAccountFolders(const QString &root, QStringList *out) {
+	QDirIterator it(
+		root,
+		QDir::Dirs | QDir::NoDotAndDotDot,
+		QDirIterator::Subdirectories);
+	while (it.hasNext()) {
+		it.next();
+		const auto path = it.filePath();
+		if (path.contains("/__MACOSX") || path.endsWith("/__MACOSX")) {
+			continue;
+		}
+		const auto tdata = path + "/tdata";
+		const auto hasTdata = QDir(tdata).exists()
+			&& (QFile::exists(tdata + "/key_datas")
+				|| QFile::exists(tdata + "/key_data"));
+		const auto hasSession = !QDir(path).entryList(
+			QStringList() << "*.session" << "*.json" << u"*密钥*"_q,
+			QDir::Files).isEmpty();
+		if (hasTdata || hasSession) {
+			out->push_back(path);
+		}
+	}
+	if (out->isEmpty()) {
+		const auto hasSession = !QDir(root).entryList(
+			QStringList() << "*.session" << "*.json" << u"*密钥*"_q,
+			QDir::Files).isEmpty();
+		if (hasSession) {
+			out->push_back(root);
+		}
+	}
+	if (out->isEmpty()) {
+		const auto tdata = root + "/tdata";
+		if (QDir(tdata).exists()
+			&& (QFile::exists(tdata + "/key_datas")
+				|| QFile::exists(tdata + "/key_data"))) {
+			out->push_back(root);
+		}
+	}
+	out->removeDuplicates();
+}
