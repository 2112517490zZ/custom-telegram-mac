+int Session::personalUnreadBadge() const {
+	auto result = 0;
+	const auto addList = [&](not_null<Dialogs::IndexedList*> list) {
+		for (const auto &row : *list) {
+			const auto history = row->history();
+			if (!history || !Custom::IsPersonalUser(history->peer)) {
+				continue;
+			}
+			const auto state = history->chatListBadgesState();
+			result += std::max(state.unreadCounter, 0);
+		}
+	};
+	addList(_chatsList.indexed());
+	return result;
+}
