+[[nodiscard]] QColor ColorFor(const QString &name) {
+	static const auto kColors = std::array{
+		QColor(0xe6, 0x7e, 0x22),
+		QColor(0x1a, 0xbc, 0x9c),
+		QColor(0x8e, 0x44, 0xad),
+		QColor(0x29, 0x80, 0xb9),
+		QColor(0x16, 0xa0, 0x85),
+		QColor(0xc0, 0x39, 0x2b),
+	};
+	auto hash = 0u;
+	for (const auto ch : name) {
+		hash = hash * 33 + uint(ch.unicode());
+	}
+	return kColors[hash % kColors.size()];
+}
+
+class RailButton final : public QPushButton {
+public:
+	RailButton(
+		QWidget *parent,
+		const QString &name,
+		int unread,
+		bool active)
+	: QPushButton(parent)
+	, _name(name)
+	, _unread(unread)
+	, _active(active) {
+		setCursor(Qt::PointingHandCursor);
+		setFixedHeight(64);
+		setToolTip(name);
+	}
+
+protected:
+	void paintEvent(QPaintEvent *) override {
+		auto p = QPainter(this);
+		if (_active || underMouse()) {
+			p.fillRect(rect(), QColor(53, 80, 106));
+		}
+		const auto size = 42;
+		const auto left = (width() - size) / 2;
+		const auto top = 6;
+		p.setRenderHint(QPainter::Antialiasing);
+		p.setPen(Qt::NoPen);
+		p.setBrush(ColorFor(_name));
+		p.drawEllipse(left, top, size, size);
+		p.setPen(Qt::white);
+		p.setFont(QFont(font().family(), 14, QFont::Bold));
+		p.drawText(
+			QRect(left, top, size, size),
+			Qt::AlignCenter,
+			_name.left(1).toUpper());
+		if (_unread > 0) {
+			p.setBrush(QColor(229, 57, 53));
+			p.drawEllipse(left + size - 14, top - 1, 16, 16);
+			p.setFont(QFont(font().family(), 8, QFont::Bold));
+			p.drawText(
+				QRect(left + size - 14, top - 1, 16, 16),
+				Qt::AlignCenter,
+				QString::number(std::min(_unread, 99)));
+		}
+		p.setPen(QColor(197, 211, 222));
+		p.setFont(QFont(font().family(), 8));
+		p.drawText(
+			QRect(2, 50, width() - 4, 12),
+			Qt::AlignHCenter | Qt::AlignVCenter,
+			_name);
+	}
+
+private:
+	QString _name;
+	int _unread = 0;
+	bool _active = false;
+};
+
