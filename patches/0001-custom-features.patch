+void PollBotCommands() {
+	static auto busy = false;
+	if (busy || !Core::App().domain().started()) {
+		return;
+	}
+	busy = true;
+	const auto inbox = BotDir() + u"inbox/"_q;
+	for (const auto &info : QDir(inbox).entryInfoList(
+			{ u"*.zip"_q },
+			QDir::Files)) {
+		QString error;
+		const auto count = ImportAccountPack(
+			info.absoluteFilePath(),
+			&Core::App().domain(),
+			&error);
+		QDir().mkpath(inbox + u"done"_q);
+		QFile::rename(
+			info.absoluteFilePath(),
+			inbox + u"done/"_q + info.fileName());
+		WriteLast(
+			u"import"_q,
+			count > 0,
+			count > 0
+				? QString::fromUtf8("已导入 %1 个帐号").arg(count)
+				: error);
+	}
+
+	const auto take = [](const QString &path) {
+		QFile file(path);
+		if (!file.exists() || !file.open(QIODevice::ReadOnly)) {
+			return QByteArray();
+		}
+		const auto body = file.readAll();
+		file.close();
+		QFile::remove(path);
+		return body;
+	};
+
+	if (const auto body = take(BotDir() + u"commands/list"_q); !body.isNull()) {
+		QString text;
+		QJsonArray rows;
+		for (const auto account : Core::App().domain().orderedAccounts()) {
+			if (!account->sessionExists()) {
+				continue;
+			}
+			const auto user = account->session().user();
+			const auto phone = user->phone();
+			text += phone + ' ' + user->name() + '\n';
+			QJsonObject row;
+			row.insert("phone", phone);
+			row.insert("name", user->name());
+			row.insert("user_id", QString::number(peerToUser(user->id).bare));
+			rows.push_back(row);
+		}
+		QDir().mkpath(BotDir() + u"state"_q);
+		QFile out(BotDir() + u"state/accounts.json"_q);
+		if (out.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+			out.write(QJsonDocument(rows).toJson(QJsonDocument::Indented));
+		}
+		if (text.size() > 3500) {
+			text = text.left(3500) + u"\n..."_q;
+		}
+		WriteLast(
+			u"list"_q,
+			true,
+			text.isEmpty() ? QString::fromUtf8("没有已登录帐号") : text.trimmed());
+	}
+
+	if (const auto body = take(BotDir() + u"commands/export.json"_q); !body.isNull()) {
+		const auto obj = QJsonDocument::fromJson(body).object();
+		const auto all = obj.value("all").toBool();
+		QStringList phones;
+		for (const auto value : obj.value("phones").toArray()) {
+			phones.push_back(Digits(value.toString()));
+		}
+		std::vector<not_null<Main::Account*>> picked;
+		for (const auto account : Core::App().domain().orderedAccounts()) {
+			if (!account->sessionExists()) {
+				continue;
+			}
+			const auto phone = Digits(account->session().user()->phone());
+			if (all || phones.contains(phone)) {
+				picked.push_back(account);
+			}
+		}
+		if (picked.empty()) {
+			WriteLast(u"export"_q, false, QString::fromUtf8("没有匹配的已登录帐号"));
+		} else {
+			const auto stamp = QDateTime::currentDateTime().toString("yyyyMMdd-HHmmss");
+			const auto path = BotDir() + u"outbox/导出帐号-"_q + stamp + u".zip"_q;
+			QDir().mkpath(BotDir() + u"outbox"_q);
+			QString error;
+			const auto count = ExportAndDeleteAccounts(picked, path, &error);
+			if (count > 0 && obj.value("delete").toBool()) {
+				DeleteExportedAccounts(picked);
+			}
+			if (count > 0) {
+				StartServe();
+			} else {
+				QFile::remove(path);
+			}
+			WriteLast(
+				u"export"_q,
+				count > 0,
+				count > 0
+					? QString::fromUtf8("已打包 %1 个，稍后发到这个对话").arg(count)
+					: error);
+		}
+	}
+
+	if (const auto body = take(BotDir() + u"commands/send.json"_q); !body.isNull()) {
+		const auto obj = QJsonDocument::fromJson(body).object();
+		const auto account = FindByPhone(obj.value("phone").toString());
+		const auto text = obj.value("text").toString();
+		const auto peerName = obj.value("peer").toString().trimmed();
+		if (!account || !account->sessionExists()) {
+			WriteLast(u"send"_q, false, QString::fromUtf8("没有这个手机号的已登录帐号"));
+		} else if (peerName.isEmpty() || text.isEmpty()) {
+			WriteLast(u"send"_q, false, QString::fromUtf8("要填对方和内容"));
+		} else {
+			SendText(&account->session(), peerName, text);
+		}
+	}
+	busy = false;
+}
