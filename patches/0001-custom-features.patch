+AccountRail::AccountRail(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller)
+: Ui::RpWidget(parent)
+, _controller(controller)
+, _search(new QLineEdit(this))
+, _scroll(new QScrollArea(this))
+, _import(new QPushButton(QString::fromUtf8("导入"), this))
+, _export(new QPushButton(QString::fromUtf8("导出"), this)) {
+	setAcceptDrops(true);
+	_search->setPlaceholderText(QString::fromUtf8("名称/号码"));
+	_search->setStyleSheet(
+		"QLineEdit{background:#1f2e3d;color:#fff;border:0;"
+		"border-radius:8px;padding:6px;font-size:11px;}");
+	_scroll->setFrameShape(QFrame::NoFrame);
+	_scroll->setWidgetResizable(true);
+	_scroll->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+	_scroll->setStyleSheet(
+		"QScrollArea{background:#293a4c;border:0;}"
+		"QScrollBar:vertical{width:6px;background:transparent;}"
+		"QScrollBar::handle:vertical{background:#6f879b;border-radius:3px;}");
+	const auto style = QString(
+		"QPushButton{background:#1f2e3d;color:#d7e4ef;border:1px dashed #6f879b;"
+		"border-radius:8px;padding:8px 4px;font-size:11px;}"
+		"QPushButton:hover{background:#35506a;}");
+	_import->setStyleSheet(style);
+	_export->setStyleSheet(
+		"QPushButton{background:#4a2a12;color:#f3d2b5;border:1px solid #8a5a2b;"
+		"border-radius:8px;padding:8px 4px;font-size:11px;}"
+		"QPushButton:hover{background:#6a3a18;}");
+
+	connect(_search, &QLineEdit::textChanged, this, [=](const QString &text) {
+		_query = text.trimmed();
+		rebuild();
+	});
+	connect(_import, &QPushButton::clicked, this, [=] {
+		ChooseAndImportAccountPack(this, &controller->session().domain());
+	});
+	connect(_export, &QPushButton::clicked, this, [=] {
+		ChooseAndExportAccounts(controller);
+	});
+
+	Core::App().domain().accountsChanges(
+	) | rpl::on_next([=] {
+		rebuild();
+	}, lifetime());
+	rebuild();
+}
+
+void AccountRail::rebuild() {
+	auto *inner = new QWidget;
+	auto *layout = new QVBoxLayout(inner);
+	layout->setContentsMargins(4, 4, 4, 4);
+	layout->setSpacing(2);
+	const auto current = &_controller->session().account();
+	for (const auto account : Core::App().domain().orderedAccounts()) {
+		if (!account->sessionExists()) {
+			continue;
+		}
+		if (!AccountMatchesQuery(account, _query)) {
+			continue;
+		}
+		const auto user = account->session().user();
+		const auto unread = account->session().data().personalUnreadBadge();
+		const auto button = new RailButton(
+			inner,
+			user->name().isEmpty() ? user->phone() : user->name(),
+			unread,
+			account == current);
+		QObject::connect(button, &QPushButton::clicked, this, [=] {
+			Core::App().domain().maybeActivate(account);
+		});
+		button->setContextMenuPolicy(Qt::CustomContextMenu);
+		QObject::connect(
+			button,
+			&QWidget::customContextMenuRequested,
+			this,
+			[=] {
+				ChooseAndExportOne(this, account);
+			});
+		layout->addWidget(button);
+	}
+	layout->addStretch();
+	_scroll->setWidget(inner);
+	_inner = inner;
+}
+
+void AccountRail::resizeEvent(QResizeEvent *e) {
+	_search->setGeometry(6, 8, width() - 12, 28);
+	_export->setGeometry(6, height() - 40, width() - 12, 32);
+	_import->setGeometry(6, height() - 78, width() - 12, 32);
+	_scroll->setGeometry(0, 42, width(), height() - 126);
+	if (_inner) {
+		_inner->setFixedWidth(width());
+	}
+}
+
+void AccountRail::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.fillRect(rect(), QColor(41, 58, 76));
+}
+
+void AccountRail::dragEnterEvent(QDragEnterEvent *e) {
+	if (!ZipPathsFromMime(e->mimeData()).isEmpty()) {
+		e->setDropAction(Qt::CopyAction);
+		e->accept();
+	}
+}
+
+void AccountRail::dropEvent(QDropEvent *e) {
+	if (TryImportDroppedZip(
+			e->mimeData(),
+			&_controller->session().domain())) {
+		e->acceptProposedAction();
+	}
+}
