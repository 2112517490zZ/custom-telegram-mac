+void AccountRail::resizeEvent(QResizeEvent *e) {
+	_search->setGeometry(6, 8, width() - 12, 28);
+	_export->setGeometry(6, height() - 40, width() - 12, 32);
+	_import->setGeometry(6, height() - 78, width() - 12, 32);
+	const auto listHeight = std::max(0, height() - 126);
+	_scroll->setGeometry(0, 42, width(), listHeight);
+	if (_inner) {
+		_inner->setFixedWidth(width());
+	}
+	_import->raise();
+	_export->raise();
+	_search->raise();
+}
+
+void AccountRail::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.fillRect(rect(), QColor(41, 58, 76));
+}
+
+void AccountRail::dragEnterEvent(QDragEnterEvent *e) {
+	if (!ZipPathsFromMime(e->mimeData()).isEmpty()) {
+		e->setDropAction(Qt::CopyAction);
+		e->accept();
+	}
+}
+
+void AccountRail::dropEvent(QDropEvent *e) {
+	if (TryImportDroppedZip(
+			e->mimeData(),
+			&_controller->session().domain())) {
+		e->acceptProposedAction();
+	}
+}
+
+} // namespace Custom
