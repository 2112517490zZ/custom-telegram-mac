+namespace Custom {
+namespace {
+
+constexpr auto kScript = R"BOT(#!/bin/bash
+# custom-bot-v2
+# Buttons live in this file. Edit and save. Do not recompile the client.
+# The client watches:
+#   inbox/*.zip
+#   commands/export.json   {"all":true} or {"phones":["84..."],"delete":false}
+#   commands/list
+#   commands/send.json     {"phone":"84...","peer":"@name","text":"hi"}
+# Add a button in keyboard() and handle it in on_button().
+if ! command -v python3 >/dev/null 2>&1; then
+  echo "python3 missing" >&2
+  exit 1
+fi
+exec python3 - "$@" << 'PY'
+import json, os, sys, time, urllib.parse, urllib.request
+
+DIR = os.path.dirname(os.path.abspath(__file__))
+CFG = os.path.join(DIR, "config.json")
+INBOX = os.path.join(DIR, "inbox")
+OUTBOX = os.path.join(DIR, "outbox")
+COMMANDS = os.path.join(DIR, "commands")
+STATE = os.path.join(DIR, "state")
+OFFSET = os.path.join(STATE, "offset")
+CHAT = os.path.join(STATE, "chat.json")
+
+def read_cfg():
+    try:
+        with open(CFG, encoding="utf-8") as handle:
+            data = json.load(handle)
+    except Exception:
+        data = {}
+    return str(data.get("token") or ""), str(data.get("admin_id") or ""), bool(data.get("enabled"))
+
+def api(token, method, payload=None):
+    url = "https://api.telegram.org/bot%s/%s" % (token, method)
+    data = urllib.parse.urlencode(payload or {}).encode()
+    req = urllib.request.Request(url, data=data)
+    with urllib.request.urlopen(req, timeout=60) as resp:
+        return json.loads(resp.read().decode())
+
+def keyboard():
+    return {"inline_keyboard": [
+        [{"text": "导入帐号", "callback_data": "import"},
+         {"text": "帐号列表", "callback_data": "list"}],
+        [{"text": "导出全部", "callback_data": "export_all"},
+         {"text": "导出指定", "callback_data": "export_ask"}],
+        [{"text": "导出并移除", "callback_data": "export_delete"},
+         {"text": "发消息", "callback_data": "send_ask"}],
+        [{"text": "帮助", "callback_data": "help"}],
+    ]}
+
+def send_text(token, admin, text, buttons=True):
+    payload = {"chat_id": admin, "text": text}
+    if buttons:
+        payload["reply_markup"] = json.dumps(keyboard(), ensure_ascii=False)
+    try:
+        api(token, "sendMessage", payload)
+    except Exception as exc:
+        print(exc, file=sys.stderr)
+
+def load_chat():
+    try:
+        with open(CHAT, encoding="utf-8") as handle:
+            return json.load(handle)
+    except Exception:
+        return {}
+
+def save_chat(data):
+    os.makedirs(STATE, exist_ok=True)
+    with open(CHAT, "w", encoding="utf-8") as handle:
+        json.dump(data, handle)
+
+def write_json(path, obj):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8") as handle:
+        json.dump(obj, handle, ensure_ascii=False)
+
+def wait_last(since, timeout=40):
+    path = os.path.join(STATE, "last.json")
+    end = time.time() + timeout
+    while time.time() < end:
+        try:
+            with open(path, encoding="utf-8") as handle:
+                data = json.load(handle)
+            if float(data.get("at") or 0) > since:
+                return data
+        except Exception:
+            pass
+        time.sleep(1)
+    return None
+
+def send_file(token, admin, path):
+    import subprocess
+    proc = subprocess.run([
+        "curl", "-sS", "--max-time", "180",
+        "-F", "chat_id=%s" % admin,
+        "-F", "document=@%s" % path,
+        "https://api.telegram.org/bot%s/sendDocument" % token,
+    ], capture_output=True, text=True)
+    return '"ok":true' in (proc.stdout or "")
+
+def download_file(token, file_id, dest):
+    info = api(token, "getFile", {"file_id": file_id})
+    if not info.get("ok"):
+        raise RuntimeError(info.get("description") or "getFile failed")
+    remote = info["result"]["file_path"]
+    url = "https://api.telegram.org/file/bot%s/%s" % (token, remote)
+    urllib.request.urlretrieve(url, dest)
+
+def on_button(token, admin, data):
+    now = time.time() * 1000
+    if data == "import":
+        save_chat({"mode": "import"})
+        send_text(token, admin, "把帐号 zip 发给我。要和储存目录里的包一样。单个包请小于 20MB。")
+    elif data == "list":
+        write_json(os.path.join(COMMANDS, "list"), {"at": now})
+        result = wait_last(now)
+        send_text(token, admin, (result or {}).get("text") or "客户端没有回应，先打开客户端。")
+    elif data == "export_all":
+        write_json(os.path.join(COMMANDS, "export.json"), {"all": True, "delete": False})
+        result = wait_last(now, 90)
+        send_text(token, admin, (result or {}).get("text") or "导出没有回应。")
+    elif data == "export_delete":
+        save_chat({"mode": "export_delete"})
+        send_text(token, admin, "回复 all 导出并移除全部，或回复手机号，多个用空格隔开。发出去之后只从本机列表拿掉，不退出登录，包可以再导入。")
+    elif data == "export_ask":
+        save_chat({"mode": "export"})
+        send_text(token, admin, "回复 all 导出全部，或回复手机号，多个用空格隔开。号会留在客户端。")
+    elif data == "send_ask":
+        save_chat({"mode": "send_phone"})
+        send_text(token, admin, "先回复用哪个号发，写手机号。")
+    elif data == "help":
+        send_text(token, admin, "导入、导出、列表、发消息都是按钮。\n加功能不用重编译，改 bot/run 里的 keyboard 和 on_button。")
+    else:
+        send_text(token, admin, "未知按钮。")
+
+def handle_text(token, admin, text):
+    chat = load_chat()
+    mode = chat.get("mode") or ""
+    now = time.time() * 1000
+    if mode == "export" or mode == "export_delete":
+        delete = mode == "export_delete"
+        if text.strip().lower() == "all":
+            body = {"all": True, "delete": delete}
+        else:
+            phones = [part for part in text.replace(",", " ").split() if part.strip()]
+            body = {"phones": phones, "delete": delete}
+        write_json(os.path.join(COMMANDS, "export.json"), body)
+        save_chat({})
+        result = wait_last(now, 90)
+        send_text(token, admin, (result or {}).get("text") or "导出没有回应。")
+    elif mode == "send_phone":
+        save_chat({"mode": "send_peer", "phone": text.strip()})
+        send_text(token, admin, "回复对方，用 @用户名。")
+    elif mode == "send_peer":
+        chat["mode"] = "send_text"
+        chat["peer"] = text.strip()
+        save_chat(chat)
+        send_text(token, admin, "回复要发的内容。")
+    elif mode == "send_text":
+        write_json(os.path.join(COMMANDS, "send.json"), {
+            "phone": chat.get("phone") or "",
+            "peer": chat.get("peer") or "",
+            "text": text,
+        })
+        save_chat({})
+        result = wait_last(now, 40)
+        send_text(token, admin, (result or {}).get("text") or "发送没有回应。")
+    else:
+        send_text(token, admin, "点下面的按钮。")
+
+def handle_document(token, admin, file_id, name):
+    os.makedirs(INBOX, exist_ok=True)
+    dest = os.path.join(INBOX, os.path.basename(name or "accounts.zip"))
+    now = time.time() * 1000
+    try:
+        download_file(token, file_id, dest)
+    except Exception as exc:
+        send_text(token, admin, "下载失败：%s" % exc)
+        return
+    result = wait_last(now, 90)
+    send_text(token, admin, (result or {}).get("text") or "客户端没有导入，先确认客户端开着。")
+
+def poll():
+    os.makedirs(STATE, exist_ok=True)
+    os.makedirs(OUTBOX, exist_ok=True)
+    os.makedirs(COMMANDS, exist_ok=True)
+    os.makedirs(INBOX, exist_ok=True)
+    offset = 0
+    try:
+        offset = int(open(OFFSET).read().strip() or "0")
+    except Exception:
+        offset = 0
+    while True:
+        token, admin, enabled = read_cfg()
+        if not enabled or not token or not admin:
+            time.sleep(5)
+            continue
+        for name in list(os.listdir(OUTBOX)):
+            path = os.path.join(OUTBOX, name)
+            if name.endswith(".zip") and os.path.isfile(path) and send_file(token, admin, path):
+                os.remove(path)
+        try:
+            data = api(token, "getUpdates", {"timeout": 20, "offset": offset})
+        except Exception:
+            time.sleep(3)
+            continue
+        for update in data.get("result") or []:
+            offset = int(update["update_id"]) + 1
+            with open(OFFSET, "w") as handle:
+                handle.write(str(offset))
+            callback = update.get("callback_query") or {}
+            message = update.get("message") or callback.get("message") or {}
+            sender = callback.get("from") or message.get("from") or {}
+            if str(sender.get("id") or "") != str(admin):
+                continue
+            if callback:
+                try:
+                    api(token, "answerCallbackQuery", {"callback_query_id": callback.get("id")})
+                except Exception:
+                    pass
+                on_button(token, admin, callback.get("data") or "")
+                continue
+            document = message.get("document") or {}
+            if document:
+                handle_document(token, admin, document.get("file_id"), document.get("file_name"))
+                continue
+            text = message.get("text") or ""
+            if text:
+                handle_text(token, admin, text)
+
+def main():
+    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
+    if cmd == "--send":
+        token, admin, enabled = read_cfg()
+        path = sys.argv[2] if len(sys.argv) > 2 else ""
+        if not send_file(token, admin, path):
+            print("send failed", file=sys.stderr)
+            return 1
+        return 0
+    if cmd == "--serve":
+        with open(os.path.join(DIR, "serve.pid"), "w") as handle:
+            handle.write(str(os.getpid()))
+        poll()
+        return 0
+    print("usage: run --send file.zip | --serve", file=sys.stderr)
+    return 1
+
+raise SystemExit(main())
+PY
+)BOT";
+
+[[nodiscard]] QString BotDir() {
+	return cWorkingDir() + u"bot/"_q;
+}
+
+[[nodiscard]] QString ConfigPath() {
+	return BotDir() + u"config.json"_q;
+}
+
+[[nodiscard]] QString ScriptPath() {
+	return BotDir() + u"run"_q;
+}
+
+[[nodiscard]] QJsonObject ReadConfig() {
+	QFile file(ConfigPath());
+	if (!file.open(QIODevice::ReadOnly)) {
+		return {};
+	}
+	return QJsonDocument::fromJson(file.readAll()).object();
+}
+
+void WriteConfig(const QString &token, const QString &adminId, bool enabled) {
+	QDir().mkpath(BotDir());
+	QDir().mkpath(BotDir() + u"outbox"_q);
+	QJsonObject obj;
+	obj.insert("token", token);
+	obj.insert("admin_id", adminId);
+	obj.insert("enabled", enabled);
+	QFile file(ConfigPath());
+	if (file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		file.write(QJsonDocument(obj).toJson(QJsonDocument::Indented));
+	}
+}
+
+bool EnsureScript() {
+	QDir().mkpath(BotDir());
+	QDir().mkpath(BotDir() + u"outbox"_q);
+	QDir().mkpath(BotDir() + u"inbox"_q);
+	QDir().mkpath(BotDir() + u"commands"_q);
+	QDir().mkpath(BotDir() + u"state"_q);
+	if (QFile::exists(ScriptPath())) {
+		QFile current(ScriptPath());
+		if (current.open(QIODevice::ReadOnly)
+			&& QString::fromUtf8(current.readAll()).contains(u"custom-bot-v2"_q)) {
+			return false;
+		}
+	}
+	QFile file(ScriptPath());
+	if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		return false;
+	}
+	file.write(kScript);
+	file.close();
+	QFile::setPermissions(
+		ScriptPath(),
+		QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner
+			| QFileDevice::ReadGroup | QFileDevice::ExeGroup
+			| QFileDevice::ReadOther | QFileDevice::ExeOther);
+	return true;
+}
+
+[[nodiscard]] bool ServeRunning() {
+	QFile file(BotDir() + u"serve.pid"_q);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return false;
+	}
+	const auto pid = QString::fromUtf8(file.readAll()).trimmed().toLongLong();
+	if (pid <= 0) {
+		return false;
+	}
+	QProcess proc;
+	proc.start("kill", { "-0", QString::number(pid) });
+	if (!proc.waitForFinished(2000)) {
+		return false;
+	}
+	return proc.exitCode() == 0;
+}
+
+void StartServe() {
+	if (EnsureScript()) {
+		QFile file(BotDir() + u"serve.pid"_q);
+		if (file.open(QIODevice::ReadOnly)) {
+			const auto pid = QString::fromUtf8(file.readAll()).trimmed();
+			file.close();
+			if (!pid.isEmpty()) {
+				QProcess proc;
+				proc.start("kill", { pid });
+				proc.waitForFinished(2000);
+			}
+		}
+		QFile::remove(BotDir() + u"serve.pid"_q);
+	}
+	if (ServeRunning()) {
+		return;
+	}
+	QProcess::startDetached(ScriptPath(), { u"--serve"_q }, BotDir());
+}
+
+[[nodiscard]] QString Digits(QString value) {
+	QString out;
+	for (const auto ch : value) {
+		if (ch.isDigit()) {
+			out.append(ch);
+		}
+	}
+	return out;
+}
+
+void WriteLast(const QString &kind, bool ok, const QString &text) {
+	QDir().mkpath(BotDir() + u"state"_q);
+	QJsonObject obj;
+	obj.insert("kind", kind);
+	obj.insert("ok", ok);
+	obj.insert("text", text);
+	obj.insert("at", double(QDateTime::currentMSecsSinceEpoch()));
+	QFile file(BotDir() + u"state/last.json"_q);
+	if (file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		file.write(QJsonDocument(obj).toJson(QJsonDocument::Indented));
+	}
+}
+
+[[nodiscard]] Main::Account *FindByPhone(const QString &phone) {
+	const auto wanted = Digits(phone);
+	if (wanted.isEmpty() || !Core::App().domain().started()) {
+		return nullptr;
+	}
+	for (const auto account : Core::App().domain().orderedAccounts()) {
+		if (!account->sessionExists()) {
+			continue;
+		}
+		if (Digits(account->session().user()->phone()) == wanted) {
+			return account.get();
+		}
+	}
+	return nullptr;
+}
+
+void SendText(not_null<Main::Session*> session, const QString &peerName, const QString &text) {
+	auto username = peerName.trimmed();
+	if (username.startsWith('@')) {
+		username.remove(0, 1);
+	}
+	const auto deliver = [=](not_null<PeerData*> peer) {
+		const auto history = session->data().history(peer->id);
+		auto message = Api::MessageToSend(Api::SendAction(history));
+		message.textWithTags = { text };
+		session->api().sendMessage(std::move(message));
+		WriteLast(
+			u"send"_q,
+			true,
+			QString::fromUtf8("已发给 %1").arg(peer->name()));
+	};
+	if (const auto known = session->data().peerByUsername(username)) {
+		deliver(known);
+		return;
+	}
+	using Flag = MTPcontacts_ResolveUsername::Flag;
+	session->api().request(MTPcontacts_ResolveUsername(
+		MTP_flags(Flag()),
+		MTP_string(username),
+		MTP_string()
+	)).done([=](const MTPcontacts_ResolvedPeer &result) {
+		result.match([&](const MTPDcontacts_resolvedPeer &data) {
+			session->data().processUsers(data.vusers());
+			session->data().processChats(data.vchats());
+			if (const auto peerId = peerFromMTP(data.vpeer())) {
+				deliver(session->data().peer(peerId));
+			}
+		});
+	}).fail([=](const MTP::Error &error) {
+		WriteLast(u"send"_q, false, error.type());
+	}).send();
+}
+
+void PollBotCommands() {
+	static auto busy = false;
+	if (busy || !Core::App().domain().started()) {
+		return;
+	}
+	busy = true;
+	const auto inbox = BotDir() + u"inbox/"_q;
+	for (const auto &info : QDir(inbox).entryInfoList(
+			{ u"*.zip"_q },
+			QDir::Files)) {
+		QString error;
+		const auto count = ImportAccountPack(
+			info.absoluteFilePath(),
+			&Core::App().domain(),
+			&error);
+		QDir().mkpath(inbox + u"done"_q);
+		QFile::rename(
+			info.absoluteFilePath(),
+			inbox + u"done/"_q + info.fileName());
+		WriteLast(
+			u"import"_q,
+			count > 0,
+			count > 0
+				? QString::fromUtf8("已导入 %1 个帐号").arg(count)
+				: error);
+	}
+
+	const auto take = [](const QString &path) {
+		QFile file(path);
+		if (!file.exists() || !file.open(QIODevice::ReadOnly)) {
+			return QByteArray();
+		}
+		const auto body = file.readAll();
+		file.close();
+		QFile::remove(path);
+		return body;
+	};
+
+	if (const auto body = take(BotDir() + u"commands/list"_q); !body.isNull()) {
+		QString text;
+		QJsonArray rows;
+		for (const auto account : Core::App().domain().orderedAccounts()) {
+			if (!account->sessionExists()) {
+				continue;
+			}
+			const auto user = account->session().user();
+			const auto phone = user->phone();
+			text += phone + ' ' + user->name() + '\n';
+			QJsonObject row;
+			row.insert("phone", phone);
+			row.insert("name", user->name());
+			row.insert("user_id", QString::number(peerToUser(user->id).bare));
+			rows.push_back(row);
+		}
+		QDir().mkpath(BotDir() + u"state"_q);
+		QFile out(BotDir() + u"state/accounts.json"_q);
+		if (out.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+			out.write(QJsonDocument(rows).toJson(QJsonDocument::Indented));
+		}
+		if (text.size() > 3500) {
+			text = text.left(3500) + u"\n..."_q;
+		}
+		WriteLast(
+			u"list"_q,
+			true,
+			text.isEmpty() ? QString::fromUtf8("没有已登录帐号") : text.trimmed());
+	}
+
+	if (const auto body = take(BotDir() + u"commands/export.json"_q); !body.isNull()) {
+		const auto obj = QJsonDocument::fromJson(body).object();
+		const auto all = obj.value("all").toBool();
+		QStringList phones;
+		for (const auto value : obj.value("phones").toArray()) {
+			phones.push_back(Digits(value.toString()));
+		}
+		std::vector<not_null<Main::Account*>> picked;
+		for (const auto account : Core::App().domain().orderedAccounts()) {
+			if (!account->sessionExists()) {
+				continue;
+			}
+			const auto phone = Digits(account->session().user()->phone());
+			if (all || phones.contains(phone)) {
+				picked.push_back(account);
+			}
+		}
+		if (picked.empty()) {
+			WriteLast(u"export"_q, false, QString::fromUtf8("没有匹配的已登录帐号"));
+		} else {
+			const auto stamp = QDateTime::currentDateTime().toString("yyyyMMdd-HHmmss");
+			const auto path = BotDir() + u"outbox/导出帐号-"_q + stamp + u".zip"_q;
+			QDir().mkpath(BotDir() + u"outbox"_q);
+			QString error;
+			const auto count = ExportAndDeleteAccounts(picked, path, &error);
+			if (count > 0 && obj.value("delete").toBool()) {
+				DeleteExportedAccounts(picked);
+			}
+			if (count > 0) {
+				StartServe();
+			} else {
+				QFile::remove(path);
+			}
+			WriteLast(
+				u"export"_q,
+				count > 0,
+				count > 0
+					? QString::fromUtf8("已打包 %1 个，稍后发到这个对话").arg(count)
+					: error);
+		}
+	}
+
+	if (const auto body = take(BotDir() + u"commands/send.json"_q); !body.isNull()) {
+		const auto obj = QJsonDocument::fromJson(body).object();
+		const auto account = FindByPhone(obj.value("phone").toString());
+		const auto text = obj.value("text").toString();
+		const auto peerName = obj.value("peer").toString().trimmed();
+		if (!account || !account->sessionExists()) {
+			WriteLast(u"send"_q, false, QString::fromUtf8("没有这个手机号的已登录帐号"));
+		} else if (peerName.isEmpty() || text.isEmpty()) {
+			WriteLast(u"send"_q, false, QString::fromUtf8("要填对方和内容"));
+		} else {
+			SendText(&account->session(), peerName, text);
+		}
+	}
+	busy = false;
+}
