+struct ScanResult {
+	std::vector<ImportedAuth> auths;
+	QString error;
+};
+
+std::vector<ImportedAuth> AuthsFromFolder(const QString &folder, bool *locked) {
+	auto result = std::vector<ImportedAuth>();
+	const auto push = [&](ImportedAuth auth) {
+		if (auth.authKey.size() != 256) {
+			return;
+		}
+		if (auth.dcId <= 0) {
+			auth.dcId = 2;
+		}
+		for (const auto &have : result) {
+			if (auth.userId != 0 && have.userId == auth.userId) {
+				return;
+			}
+		}
+		result.push_back(std::move(auth));
+	};
+	const auto direct = ReadAccountFolder(folder);
+	push(direct);
+	// A .session / 密钥.txt already has the login. The tdata beside it in
+	// these packs is the same empty template for every account.
+	if (direct.authKey.size() == 256) {
+		return result;
+	}
+	auto many = std::vector<ImportedAuth>();
+	const auto tdata = folder + u"/tdata"_q;
+	if (QFile::exists(folder + u"/key_datas"_q)
+		|| QFile::exists(folder + u"/key_data"_q)) {
+		ReadTdataAuths(folder, &many, locked);
+	} else if (QDir(tdata).exists()) {
+		ReadTdataAuths(tdata, &many, locked);
+	}
+	for (const auto &auth : many) {
+		push(auth);
+	}
+	return result;
+}
+
+ScanResult ScanAccounts(const QString &path) {
+	ScanResult result;
+	const auto own = QFileInfo(cWorkingDir() + u"tdata"_q).absoluteFilePath();
+	if (QFileInfo(path).absoluteFilePath() == own) {
+		result.error = QString::fromUtf8("不要导入本机正在使用的 tdata");
+		return result;
+	}
+	QTemporaryDir temp;
+	if (!temp.isValid()) {
+		result.error = u"temp dir"_q;
+		return result;
+	}
+	auto scanRoot = path;
+	const auto info = QFileInfo(path);
+	if (info.isFile() && path.endsWith(u".zip"_q, Qt::CaseInsensitive)) {
+		if (!UnzipTo(path, temp.path())) {
+			result.error = u"unzip failed"_q;
+			return result;
+		}
+		scanRoot = temp.path();
+	} else if (!info.isDir()) {
+		result.error = u"not zip or folder"_q;
+		return result;
+	}
+	QStringList folders;
+	CollectAccountFolders(scanRoot, &folders);
+	if (folders.isEmpty()
+		&& (QFile::exists(scanRoot + u"/key_datas"_q)
+			|| QFile::exists(scanRoot + u"/key_data"_q))) {
+		folders.push_back(scanRoot);
+	}
+	if (folders.isEmpty()) {
+		result.error = u"no tdata/session folders"_q;
+		return result;
+	}
+	auto locked = false;
+	for (const auto &folder : folders) {
+		for (auto &auth : AuthsFromFolder(folder, &locked)) {
+			result.auths.push_back(std::move(auth));
+		}
+	}
+	if (result.auths.empty()) {
+		result.error = locked
+			? QString::fromUtf8(
+				"这个 tdata 有本地密码，先在原客户端去掉密码再导入")
+			: QString::fromUtf8("找到目录但没有可导入的 session/tdata");
+	}
+	return result;
+}
