+void AccountRail::noteUnread(not_null<Main::Account*> account) {
+	if (!account->sessionExists()) {
+		return;
+	}
+	const auto now = account->session().data().personalUnreadBadge();
+	const auto previous = _lastUnread[account.get()];
+	_lastUnread[account.get()] = now;
+	if (const auto widget = _byAccount[account.get()]) {
+		static_cast<RailButton*>(widget)->setUnread(now);
+	}
+	if (now > previous) {
+		_bounceAt[account.get()] = QDateTime::currentMSecsSinceEpoch();
+		if (!_bounce->isActive()) {
+			_bounce->start(40);
+		}
+	}
+}
+
+void AccountRail::tickBounce() {
+	const auto now = QDateTime::currentMSecsSinceEpoch();
+	auto alive = false;
+	for (auto &[account, started] : _bounceAt) {
+		const auto widget = _byAccount[account];
+		if (!widget) {
+			continue;
+		}
+		const auto elapsed = now - started;
+		if (elapsed > 1200) {
+			static_cast<RailButton*>(widget)->setHop(0);
+			continue;
+		}
+		alive = true;
+		const auto hop = int(std::sin(elapsed / 140.0) * 6);
+		static_cast<RailButton*>(widget)->setHop(std::abs(hop));
+	}
+	if (!alive) {
+		_bounce->stop();
+		_bounceAt.clear();
+	}
+}
