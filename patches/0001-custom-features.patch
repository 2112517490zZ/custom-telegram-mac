+void OpenSystemChooser(bool folder, not_null<Main::Domain*> domain) {
+	// An in-process NSOpenPanel posts a close to this window when the
+	// user confirms. Ignoring that close never returns from AppKit, and
+	// accepting it hides the app. The system panel runs in osascript.
+	SetFileDialogActive(true);
+	auto *process = new QProcess(&Core::App());
+	const auto script = folder
+		? QString::fromUtf8(
+			"POSIX path of (choose folder with prompt \"选择 tdata 文件夹\")")
+		: QString::fromUtf8(
+			"POSIX path of (choose file with prompt \"选择压缩包\")");
+	QObject::connect(
+		process,
+		&QProcess::finished,
+		&Core::App(),
+		[=](int, QProcess::ExitStatus) {
+			const auto path = QString::fromUtf8(
+				process->readAllStandardOutput()).trimmed();
+			process->deleteLater();
+			QTimer::singleShot(0, &Core::App(), [=] {
+				if (path.isEmpty()) {
+					ReleaseFileDialog();
+					return;
+				}
+				FinishImport(path, domain);
+			});
+		});
+	QObject::connect(
+		process,
+		&QProcess::errorOccurred,
+		&Core::App(),
+		[=](QProcess::ProcessError error) {
+			if (error == QProcess::FailedToStart) {
+				process->deleteLater();
+				ReleaseFileDialog();
+				Ui::Toast::Show(QString::fromUtf8("系统选择窗口没有打开"));
+			}
+		});
+	process->start(u"/usr/bin/osascript"_q, { u"-e"_q, script });
+}
