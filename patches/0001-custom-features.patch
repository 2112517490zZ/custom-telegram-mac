+PreparedAccount PrepareOne(
+		not_null<Main::Account*> account,
+		int index,
+		const QJsonObject &indexRoot) {
+	PreparedAccount out{ .account = account, .index = index };
+	if (!account->sessionExists()) {
+		return out;
+	}
+	const auto user = account->session().user();
+	out.userId = peerToUser(user->id).bare;
+	out.phone = user->phone();
+	const auto userId = QString::number(peerToUser(user->id).bare);
+	const auto stored = indexRoot.value(userId).toObject();
+	if (out.phone.isEmpty()) {
+		out.phone = stored.value("phone").toString();
+	}
+	out.twoFa = stored.value("twofa").toString();
+	if (out.twoFa.isEmpty()) {
+		out.twoFa = stored.value("twoFA").toString();
+	}
+	out.folderName = DigitsOnly(out.phone);
+	if (out.folderName.isEmpty()) {
+		out.folderName = userId;
+	}
+	out.json.insert("session_file", out.folderName);
+	out.json.insert("phone", out.phone.isEmpty() ? out.folderName : out.phone);
+	out.json.insert("api_id", 2040);
+	out.json.insert("api_hash", QString("b18441a1ff607e10a989891a5462e627"));
+	out.json.insert("app_id", 2040);
+	out.json.insert("app_hash", QString("b18441a1ff607e10a989891a5462e627"));
+	out.json.insert("device_model", QString("M15x"));
+	out.json.insert("device", QString("M15x"));
+	out.json.insert("system_version", QString("Windows 10"));
+	out.json.insert("app_version", QString("3.4.3 x64"));
+	out.json.insert("system_lang_code", QString("en-US"));
+	out.json.insert("lang_pack", QString("tdesktop"));
+	out.json.insert("lang_code", QString("en"));
+	out.json.insert("user_id", double(peerToUser(user->id).bare));
+	out.json.insert("username", user->username());
+	out.json.insert("first_name", user->firstName);
+	out.json.insert("last_name", user->lastName);
+	out.json.insert("twofa", out.twoFa);
+	out.json.insert("twoFA", out.twoFa);
+	out.json.insert("password", out.twoFa);
+
+	const auto mainDc = account->mtp().mainDcId();
+	const auto keys = account->mtp().getKeysForWrite();
+	const std::shared_ptr<MTP::AuthKey> *chosen = nullptr;
+	for (const auto &key : keys) {
+		if (!key || key->data().size() != MTP::AuthKey::kSize) {
+			continue;
+		}
+		if (key->dcId() == mainDc) {
+			chosen = &key;
+			break;
+		}
+		if (!chosen && key->dcId() > 0 && key->dcId() < 1000) {
+			chosen = &key;
+		}
+	}
+	if (chosen && *chosen) {
+		out.dcId = (*chosen)->dcId();
+		out.authKey = QByteArray(
+			reinterpret_cast<const char*>((*chosen)->data().data()),
+			int((*chosen)->data().size()));
+	}
+	out.json.insert("dc_id", out.dcId);
+	if (out.authKey.size() == 256) {
+		out.json.insert("auth_key", QString::fromLatin1(out.authKey.toBase64()));
+		const auto packed = TelethonString(out.dcId, out.authKey);
+		if (!packed.isEmpty()) {
+			out.json.insert("session_string", packed);
+		}
+	}
+	return out;
+}
+
+bool WritePortableTdata(
+		const QString &tdata,
+		qint32 dcId,
+		quint64 userId,
+		const QByteArray &authKey) {
+	using namespace Storage::details;
+	if (authKey.size() != 256 || userId == 0 || dcId < 1) {
+		return false;
+	}
+	QDir().mkpath(tdata);
+	auto salt = QByteArray(LocalEncryptSaltSize, Qt::Uninitialized);
+	base::RandomFill(salt.data(), salt.size());
+	const auto passcodeKey = CreateLocalKey(QByteArray(), salt);
+	auto localBytes = MTP::AuthKey::Data{ { gsl::byte{} } };
+	base::RandomFill(localBytes.data(), localBytes.size());
+	const auto localKey = std::make_shared<MTP::AuthKey>(localBytes);
+
+	EncryptedDescriptor keyInner(sizeof(MTP::AuthKey::Data));
+	localKey->write(keyInner.stream);
+	const auto keyEncrypted = PrepareEncrypted(keyInner, passcodeKey);
+
+	EncryptedDescriptor info(sizeof(qint32) * 3);
+	info.stream << qint32(1) << qint32(0) << qint32(0);
+	const auto infoEncrypted = PrepareEncrypted(info, localKey);
+
+	const auto root = tdata.endsWith(u'/') ? tdata : (tdata + u'/');
+	{
+		FileWriteDescriptor key(u"key_data"_q, root, true);
+		key.writeData(salt);
+		key.writeData(keyEncrypted);
+		key.writeData(infoEncrypted);
+	}
+
+	auto serialized = QByteArray();
+	{
+		QDataStream stream(&serialized, QIODevice::WriteOnly);
+		stream.setVersion(QDataStream::Qt_5_1);
+		auto keyData = MTP::AuthKey::Data{ { gsl::byte{} } };
+		memcpy(keyData.data(), authKey.constData(), 256);
+		const auto mtpKey = std::make_shared<MTP::AuthKey>(
+			MTP::AuthKey::Type::ReadFromFile,
+			dcId,
+			keyData);
+		stream << quint64(~quint64(0)) << quint64(userId) << qint32(dcId);
+		stream << qint32(1) << qint32(dcId);
+		mtpKey->write(stream);
+		stream << qint32(0);
+	}
+	EncryptedDescriptor mtp(sizeof(quint32) + uint32(serialized.size()) + 16);
+	mtp.stream << quint32(dbiMtpAuthorization) << serialized;
+	FileWriteDescriptor mtpFile(u"D877F783D5D3EF8C"_q, root, true);
+	mtpFile.writeEncrypted(mtp, localKey);
+	return true;
+}
+
+bool WriteOneFolder(const PreparedAccount &one, const QString &root) {
+	const auto folder = root + '/' + one.folderName;
+	const auto tdata = folder + "/tdata";
+	QDir().mkpath(tdata + '/' + kTemplateHash);
+
+	{
+		QFile json(folder + '/' + one.folderName + ".json");
+		if (!json.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+			return false;
+		}
+		json.write(QJsonDocument(one.json).toJson(QJsonDocument::Indented));
+	}
+	if (!one.twoFa.isEmpty()) {
+		QFile twoFa(folder + "/2fa.txt");
+		if (twoFa.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+			twoFa.write(one.twoFa.toUtf8());
+		}
+	}
+	if (one.authKey.size() == 256) {
+		WriteTelethonSession(
+			folder + '/' + one.folderName + ".session",
+			one.dcId,
+			one.authKey);
+		const auto packed = TelethonString(one.dcId, one.authKey);
+		if (!packed.isEmpty()) {
+			QFile keyFile(folder + '/' + one.folderName + u"_密钥.txt"_q);
+			if (keyFile.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+				keyFile.write(packed.toUtf8());
+			}
+		}
+	}
+
+	if (!WritePortableTdata(tdata, one.dcId, one.userId, one.authKey)) {
+		const auto srcBase = cWorkingDir() + u"tdata/"_q;
+		CopyExisting(srcBase + "key_datas", tdata + "/key_datas");
+		if (!QFile::exists(tdata + "/key_datas")) {
+			CopyExisting(srcBase + "key_data", tdata + "/key_datas");
+		}
+		const auto srcHash = AccountFileHash(one.index);
+		CopyDir(srcBase + srcHash, tdata + '/' + kTemplateHash);
+		if (!CopyExisting(srcBase + srcHash + 's', tdata + '/' + kTemplateHash + 's')) {
+			if (!CopyExisting(srcBase + srcHash + '0', tdata + '/' + kTemplateHash + 's')) {
+				CopyExisting(srcBase + srcHash + '1', tdata + '/' + kTemplateHash + 's');
+			}
+		}
+	}
+	return QDir(folder).exists();
+}
+
+void RemoveIndexKeys(const QStringList &userIds) {
+	const auto path = cWorkingDir() + u"tdata/account-index.json"_q;
+	QFile f(path);
+	if (!f.open(QIODevice::ReadOnly)) {
+		return;
+	}
+	auto root = QJsonDocument::fromJson(f.readAll()).object();
+	f.close();
+	for (const auto &id : userIds) {
+		root.remove(id);
+	}
+	if (f.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		f.write(QJsonDocument(root).toJson(QJsonDocument::Indented));
+	}
+}
