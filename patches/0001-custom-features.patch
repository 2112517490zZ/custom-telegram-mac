+bool Domain::importAuthorized(
+		qint32 dcId,
+		quint64 userId,
+		const QByteArray &authKey) {
+	Expects(started());
+	if (authKey.size() != 256 || userId == 0) {
+		return false;
+	}
+	if (_accounts.size() >= kMaxAccounts
+		|| int(_accounts.size()) >= maxAccounts()) {
+		return false;
+	}
+	for (const auto &[index, existing] : _accounts) {
+		if (existing->sessionExists()
+			&& existing->session().userId().bare == userId) {
+			return false;
+		}
+	}
+
+	static const auto cloneConfig = [](const MTP::Config &config) {
+		return std::make_unique<MTP::Config>(config);
+	};
+	auto config = cloneConfig(_active.current()
+		? _active.current()->mtp().config()
+		: Core::App().fallbackProductionConfig());
+
+	auto index = 0;
+	while (ranges::contains(_accounts, index, &AccountWithIndex::index)) {
+		++index;
+	}
+	_accounts.push_back(AccountWithIndex{
+		.index = index,
+		.account = std::make_unique<Account>(this, _dataName, index),
+	});
+	const auto account = _accounts.back().account.get();
+	account->setMtpMainDcId(dcId);
+	account->setSessionUserId(UserId(userId));
+	auto keyData = MTP::AuthKey::Data{ { gsl::byte{} } };
+	memcpy(keyData.data(), authKey.constData(), 256);
+	account->setLegacyMtpKey(std::make_shared<MTP::AuthKey>(
+		MTP::AuthKey::Type::ReadFromFile,
+		dcId,
+		keyData));
+	_local->startAdded(account, std::move(config));
+	watchSession(account);
+	_accountsChanges.fire({});
+	scheduleWriteAccounts();
+	return true;
+}
