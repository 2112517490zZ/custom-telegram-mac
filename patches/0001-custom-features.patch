+[[nodiscard]] QString ComposeDataString(int index) {
+	auto result = u"data"_q;
+	if (index > 0) {
+		result += '#' + QString::number(index + 1);
+	}
+	return result;
+}
+
+[[nodiscard]] QString AccountFileHash(int index) {
+	FileKey hash[2] = { 0 };
+	const auto utf8 = ComposeDataString(index).toUtf8();
+	hashMd5(utf8.constData(), utf8.size(), hash);
+	return Storage::details::ToFilePart(hash[0]);
+}
+
+[[nodiscard]] QString DigitsOnly(QString value) {
+	value.remove(QRegularExpression("[^0-9]"));
+	return value;
+}
+
+void CopyDir(const QString &src, const QString &dst) {
+	QDir().mkpath(dst);
+	const auto list = QDir(src).entryInfoList(
+		QDir::Files | QDir::Dirs | QDir::NoDotAndDotDot);
+	for (const auto &info : list) {
+		const auto target = dst + '/' + info.fileName();
+		if (info.isDir()) {
+			CopyDir(info.filePath(), target);
+		} else {
+			QFile::remove(target);
+			QFile::copy(info.filePath(), target);
+		}
+	}
+}
+
+bool CopyExisting(const QString &src, const QString &dst) {
+	if (!QFile::exists(src)) {
+		return false;
+	}
+	QDir().mkpath(QFileInfo(dst).absolutePath());
+	QFile::remove(dst);
+	return QFile::copy(src, dst);
+}
+
+bool WriteTelethonSession(
+		const QString &path,
+		qint32 dcId,
+		const QByteArray &authKey) {
+	if (dcId <= 0 || authKey.size() != 256) {
+		return false;
+	}
+	QFile::remove(path);
+	sqlite3 *db = nullptr;
+	const auto utf8 = QDir::toNativeSeparators(path).toUtf8();
+	if (sqlite3_open(utf8.constData(), &db) != SQLITE_OK) {
+		if (db) {
+			sqlite3_close(db);
+		}
+		return false;
+	}
+	sqlite3_exec(
+		db,
+		"CREATE TABLE sessions ("
+		"dc_id INTEGER PRIMARY KEY,"
+		"server_address TEXT,"
+		"port INTEGER,"
+		"auth_key BLOB)",
+		nullptr,
+		nullptr,
+		nullptr);
+	static const auto kHost = std::array<const char*, 6>{
+		"",
+		"149.154.175.53",
+		"149.154.167.51",
+		"149.154.175.100",
+		"149.154.167.91",
+		"91.108.56.165",
+	};
+	const auto host = (dcId >= 1 && dcId <= 5) ? kHost[dcId] : kHost[2];
+	sqlite3_stmt *stmt = nullptr;
+	const auto sql = "INSERT INTO sessions VALUES (?1, ?2, 443, ?3)";
+	auto ok = false;
+	if (sqlite3_prepare_v2(db, sql, -1, &stmt, nullptr) == SQLITE_OK) {
+		sqlite3_bind_int(stmt, 1, dcId);
+		sqlite3_bind_text(stmt, 2, host, -1, SQLITE_TRANSIENT);
+		sqlite3_bind_blob(
+			stmt,
+			3,
+			authKey.constData(),
+			authKey.size(),
+			SQLITE_TRANSIENT);
+		ok = (sqlite3_step(stmt) == SQLITE_DONE);
+		sqlite3_finalize(stmt);
+	}
+	sqlite3_close(db);
+	return ok;
+}
+
+bool ZipFolder(const QString &folder, const QString &zipPath) {
+	QFile::remove(zipPath);
+	QProcess proc;
+	proc.setProgram("zip");
+	proc.setWorkingDirectory(QFileInfo(folder).absolutePath());
+	proc.setArguments({
+		"-qr",
+		zipPath,
+		QFileInfo(folder).fileName(),
+	});
+	proc.start();
+	if (!proc.waitForFinished(10 * 60 * 1000)) {
+		proc.kill();
+		return false;
+	}
+	return proc.exitCode() == 0 && QFile::exists(zipPath);
+}
