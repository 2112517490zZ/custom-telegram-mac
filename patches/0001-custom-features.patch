+	const auto w = (width() - 28) / 3;
+	_all->setGeometry(x, y, w, 26); x += w + 4;
+	_user->setGeometry(x, y, w, 26); x += w + 4;
+	_group->setGeometry(x, y, w, 26);
+	x = 10;
+	_channel->setGeometry(x, y + 30, w, 26); x += w + 4;
+	_bot->setGeometry(x, y + 30, w, 26);
+	_hint->setGeometry(10, 132, width() - 20, 18);
+	_list->setGeometry(0, 154, width(), height() - 154);
+}
