+void StartServe() {
+	if (EnsureScript()) {
+		QFile file(BotDir() + u"serve.pid"_q);
+		if (file.open(QIODevice::ReadOnly)) {
+			const auto pid = QString::fromUtf8(file.readAll()).trimmed();
+			file.close();
+			if (!pid.isEmpty()) {
+				QProcess proc;
+				proc.start("kill", { pid });
+				proc.waitForFinished(2000);
+			}
+		}
+		QFile::remove(BotDir() + u"serve.pid"_q);
+	}
+	if (ServeRunning()) {
+		return;
+	}
+	QProcess::startDetached(ScriptPath(), { u"--serve"_q }, BotDir());
+}
