+QString FindBin(const QString &name) {
+	const auto paths = QStringList{
+		u"/usr/bin/"_q + name,
+		u"/bin/"_q + name,
+		u"/usr/local/bin/"_q + name,
+		name,
+	};
+	for (const auto &path : paths) {
+		if (path.contains('/')
+			&& QFileInfo::exists(path)
+			&& QFileInfo(path).isExecutable()) {
+			return path;
+		}
+	}
+	return name;
+}
+
+bool RunTool(
+		const QString &program,
+		const QStringList &args,
+		const QString &cwd,
+		int timeoutMs) {
+	QProcess proc;
+	proc.setProgram(program);
+	proc.setArguments(args);
+	if (!cwd.isEmpty()) {
+		proc.setWorkingDirectory(cwd);
+	}
+	proc.start();
+	if (!proc.waitForFinished(timeoutMs)) {
+		proc.kill();
+		proc.waitForFinished(3000);
+		return false;
+	}
+	return proc.exitStatus() == QProcess::NormalExit && proc.exitCode() == 0;
+}
+
+bool ZipFolder(const QString &folder, const QString &zipPath) {
+	QFile::remove(zipPath);
+	const auto names = QDir(folder).entryList(
+		QDir::Dirs | QDir::Files | QDir::NoDotAndDotDot);
+	if (names.isEmpty()) {
+		return false;
+	}
+	const auto timeout = 10 * 60 * 1000;
+	if (RunTool(
+			FindBin(u"zip"_q),
+			QStringList{ u"-qr"_q, zipPath } + names,
+			folder,
+			timeout)
+		&& QFile::exists(zipPath)) {
+		return true;
+	}
+	const auto ditto = FindBin(u"ditto"_q);
+	if (ditto.contains('/')
+		&& RunTool(
+			ditto,
+			{ u"-c"_q, u"-k"_q, u"--norsrc"_q, folder, zipPath },
+			QString(),
+			timeout)
+		&& QFile::exists(zipPath)) {
+		return true;
+	}
+	const auto script = QString::fromUtf8(
+		"import pathlib, zipfile, sys\n"
+		"root = pathlib.Path(sys.argv[1])\n"
+		"out = pathlib.Path(sys.argv[2])\n"
+		"with zipfile.ZipFile(out, 'w', zipfile.ZIP_DEFLATED) as z:\n"
+		"    for p in root.rglob('*'):\n"
+		"        if p.is_file():\n"
+		"            z.write(p, p.relative_to(root).as_posix())\n");
+	return RunTool(
+		FindBin(u"python3"_q),
+		{ u"-c"_q, script, folder, zipPath },
+		QString(),
+		timeout)
+		&& QFile::exists(zipPath);
+}
+
+bool UnzipFile(const QString &zipPath, const QString &dest) {
+	QDir().mkpath(dest);
+	const auto timeout = 10 * 60 * 1000;
+	if (RunTool(
+			FindBin(u"unzip"_q),
+			{ u"-qq"_q, u"-o"_q, zipPath, u"-d"_q, dest },
+			QString(),
+			timeout)) {
+		return true;
+	}
+	const auto ditto = FindBin(u"ditto"_q);
+	if (ditto.contains('/')
+		&& RunTool(
+			ditto,
+			{ u"-x"_q, u"-k"_q, zipPath, dest },
+			QString(),
+			timeout)) {
+		return true;
+	}
+	const auto script = QString::fromUtf8(
+		"import zipfile, sys\n"
+		"zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])\n");
+	return RunTool(
+		FindBin(u"python3"_q),
+		{ u"-c"_q, script, zipPath, dest },
+		QString(),
+		timeout);
+}
+
+bool SendExportViaBot(const QString &zipPath, QString *error) {
+	EnsureScript();
+	const auto config = ReadConfig();
+	if (config.value("token").toString().trimmed().isEmpty()
+		|| config.value("admin_id").toString().trimmed().isEmpty()) {
+		if (error) {
+			*error = QString::fromUtf8(
+				"先在控制面板填写机器人 Token 和管理员 ID");
+		}
+		return false;
+	}
+	QProcess proc;
+	proc.setProgram(ScriptPath());
+	proc.setArguments({ u"--send"_q, zipPath });
+	proc.setWorkingDirectory(BotDir());
+	proc.start();
+	if (!proc.waitForFinished(180000)) {
+		proc.kill();
+		if (error) *error = QString::fromUtf8("发给机器人超时");
+		return false;
+	}
+	if (proc.exitCode() != 0) {
+		const auto detail = QString::fromUtf8(proc.readAllStandardError()).trimmed();
+		if (error) {
+			*error = detail.isEmpty()
+				? QString::fromUtf8("机器人没有发出去，号还在")
+				: detail;
+		}
+		return false;
+	}
+	return true;
+}
+
+void ShowControlPanel(not_null<Window::SessionController*> controller) {
+	controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(QString::fromUtf8("控制面板")));
+		const auto saved = ReadConfig();
+		const auto limit = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(QString::fromUtf8("帐号数量上限")),
+			QString::number(Core::App().domain().maxAccounts())));
+		const auto token = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(QString::fromUtf8("机器人 Token")),
+			saved.value("token").toString()));
+		const auto admin = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(QString::fromUtf8("管理员 ID")),
+			saved.value("admin_id").toString()));
+		const auto enabled = box->addRow(object_ptr<Ui::Checkbox>(
+			box,
+			QString::fromUtf8("自动运行机器人"),
+			saved.value("enabled").toBool(),
+			st::defaultBoxCheckbox));
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(QString::fromUtf8(
+				"导出的号包由机器人发给这个管理员。"
+				"机器人按钮在 TelegramForcePortable/bot/run，改那个文件不用重新编译。"
+				"里面可以导入、导出、看列表、发消息，再加按钮也只改这个文件。")),
+			st::boxLabel));
+		box->addButton(tr::lng_settings_save(), [=] {
+			auto n = limit->getLastText().trimmed().toInt();
+			if (n <= 0) {
+				n = Core::App().domain().maxAccounts();
+			}
+			n = std::clamp(n, 1, Main::Domain::kMaxAccounts);
+			SetEnhancedValue("max_accounts", n);
+			EnhancedSettings::Write();
+			Core::App().domain().notifyMaxAccounts(n);
+			WriteConfig(
+				token->getLastText().trimmed(),
+				admin->getLastText().trimmed(),
+				enabled->checked());
+			if (enabled->checked()) {
+				StartServe();
+			}
+			box->closeBox();
+			Ui::Toast::Show(QString::fromUtf8("已保存。帐号上限 %1。").arg(n));
+		});
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	}));
+}
+
