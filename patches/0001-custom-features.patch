+// Mac posts a window-close when the file panel goes away. Clearing the
+// flag in that same turn lets the close hide the app. Activation has to
+// wait until that close has been ignored, or AppKit does not return.
+void ReleaseFileDialog(Fn<void()> done = nullptr) {
+	crl::on_main(&Core::App(), [=] {
+		crl::on_main(&Core::App(), [=] {
+			SetFileDialogActive(false);
+			if (done) {
+				done();
+			}
+		});
+	});
+}
