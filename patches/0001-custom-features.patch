+void StartExport(
+		const std::vector<not_null<Main::Account*>> &accounts,
+		QWidget *parent) {
+	if (accounts.empty()) {
+		Ui::Toast::Show(QString::fromUtf8("没有选中帐号"));
+		return;
+	}
+	const auto stamp = QDateTime::currentDateTime().toString(
+		"yyyyMMdd-HHmmss");
+	const auto dir = cWorkingDir() + u"bot/outbox/"_q;
+	QDir().mkpath(dir);
+	const auto path = dir + u"导出帐号-"_q + stamp + u".zip"_q;
+	QString error;
+	const auto n = ExportAndDeleteAccounts(accounts, path, &error);
+	if (n <= 0) {
+		QFile::remove(path);
+		ShowExportResult(0, error);
+		return;
+	}
+	QString botError;
+	if (SendExportViaBot(path, &botError)) {
+		QFile::remove(path);
+		DeleteExportedAccounts(accounts);
+		ShowExportResult(n, QString());
+		return;
+	}
+	const auto keep = accounts;
+	const auto tempPath = path;
+	const auto count = n;
+	FileDialog::GetWritePath(
+		parent ? parent : Core::App().getFileDialogParent(),
+		QString::fromUtf8("保存帐号包"),
+		"Zip (*.zip);;All files (*.*)",
+		QDir::homePath() + '/' + QFileInfo(tempPath).fileName(),
+		[=](QString &&saveTo) {
+			if (saveTo.isEmpty()) {
+				QFile::remove(tempPath);
+				Ui::Toast::Show(QString::fromUtf8("已取消，号还在客户端"));
+				return;
+			}
+			QFile::remove(saveTo);
+			if (!QFile::copy(tempPath, saveTo) && !QFile::rename(tempPath, saveTo)) {
+				ShowExportResult(0, QString::fromUtf8("保存失败"));
+				return;
+			}
+			QFile::remove(tempPath);
+			DeleteExportedAccounts(keep);
+			Ui::Toast::Show(QString::fromUtf8(
+				"已导出 %1 个帐号到 %2").arg(count).arg(saveTo));
+		},
+		[=] {
+			QFile::remove(tempPath);
+			Ui::Toast::Show(QString::fromUtf8(
+				"机器人没发出去，也没有保存文件。号还在。%1").arg(botError));
+		});
+}
