+[[nodiscard]] QString KindLabel(not_null<PeerData*> peer) {
+	if (peer->isUser()) {
+		return peer->isBot()
+			? QString::fromUtf8("机器人")
+			: QString::fromUtf8("用户");
+	} else if (peer->isChat() || peer->isMegagroup()) {
+		return QString::fromUtf8("群组");
+	} else if (peer->isBroadcast()) {
+		return QString::fromUtf8("频道");
+	}
+	return QString::fromUtf8("其他");
+}
+
+} // namespace
+
+SearchPanel::SearchPanel(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller)
+: Ui::RpWidget(parent)
+, _controller(controller)
+, _title(new QLabel(QString::fromUtf8("当前帐号消息搜索"), this))
+, _query(new QLineEdit(this))
+, _all(new QPushButton(QString::fromUtf8("全部"), this))
+, _user(new QPushButton(QString::fromUtf8("用户"), this))
+, _group(new QPushButton(QString::fromUtf8("群组"), this))
+, _channel(new QPushButton(QString::fromUtf8("频道"), this))
+, _bot(new QPushButton(QString::fromUtf8("机器人"), this))
+, _hint(new QLabel(QString::fromUtf8("底部显示搜索结果"), this))
+, _list(new QListWidget(this))
+, _timer([=] { requestSearch(); }) {
+	setAcceptDrops(true);
+	_title->setStyleSheet("color:#e4ecf2;font-weight:700;font-size:12px;background:transparent;");
+	_query->setPlaceholderText(QString::fromUtf8("输入关键词，搜这个号的全部消息"));
+	_query->setClearButtonEnabled(true);
+	_query->setStyleSheet(
+		"QLineEdit{background:#0e1621;color:#ffffff;border:0;"
+		"border-radius:8px;padding:6px;}");
+	_hint->setStyleSheet("color:#8ea4b8;font-size:11px;background:transparent;");
+	_list->setStyleSheet(
+		"QListWidget{border:0;background:#17212b;color:#ffffff;}"
+		"QListWidget::item{padding:8px;color:#ffffff;"
+		"background:#17212b;border-bottom:1px solid #101921;}"
+		"QListWidget::item:selected{background:#2b5278;color:#ffffff;}");
+	const auto buttons = { _all, _user, _group, _channel, _bot };
+	for (const auto button : buttons) {
+		button->setCheckable(true);
+		button->setCursor(Qt::PointingHandCursor);
+		button->setStyleSheet(
+			"QPushButton{background:#0e1621;color:#d7e4ef;border:1px solid #2b3d4f;"
+			"border-radius:8px;padding:4px 8px;}"
+			"QPushButton:checked{background:#3390ec;color:#ffffff;border:0;}");
+	}
+	_all->setChecked(true);
+
+	connect(_query, &QLineEdit::textChanged, this, [=](const QString &text) {
+		_text = text.trimmed();
+		_timer.cancel();
+		if (_text.isEmpty()) {
+			_list->clear();
+			_hits.clear();
+			_hint->setText(QString::fromUtf8("底部显示搜索结果"));
+			return;
+		}
+		_timer.callOnce(320);
+	});
+	connect(_all, &QPushButton::clicked, this, [=] { setFilter(Filter::All); });
+	connect(_user, &QPushButton::clicked, this, [=] { setFilter(Filter::User); });
+	connect(_group, &QPushButton::clicked, this, [=] { setFilter(Filter::Group); });
+	connect(_channel, &QPushButton::clicked, this, [=] { setFilter(Filter::Channel); });
+	connect(_bot, &QPushButton::clicked, this, [=] { setFilter(Filter::Bot); });
+	connect(_list, &QListWidget::itemClicked, this, [=](QListWidgetItem *) {
+		openRow(_list->currentRow());
+	});
+}
+
+void SearchPanel::setFilter(Filter filter) {
+	_filter = filter;
+	_all->setChecked(filter == Filter::All);
+	_user->setChecked(filter == Filter::User);
+	_group->setChecked(filter == Filter::Group);
+	_channel->setChecked(filter == Filter::Channel);
+	_bot->setChecked(filter == Filter::Bot);
+	if (!_text.isEmpty()) {
+		requestSearch();
+	}
+}
+
+void SearchPanel::resizeEvent(QResizeEvent *e) {
+	_title->setGeometry(10, 8, width() - 20, 18);
+	_query->setGeometry(10, 30, width() - 20, 32);
+	auto x = 10;
+	const auto y = 70;
+	const auto w = (width() - 28) / 3;
+	_all->setGeometry(x, y, w, 26); x += w + 4;
+	_user->setGeometry(x, y, w, 26); x += w + 4;
+	_group->setGeometry(x, y, w, 26);
+	x = 10;
+	_channel->setGeometry(x, y + 30, w, 26); x += w + 4;
+	_bot->setGeometry(x, y + 30, w, 26);
+	_hint->setGeometry(10, 132, width() - 20, 18);
+	_list->setGeometry(0, 154, width(), height() - 154);
+}
+
+void SearchPanel::paintEvent(QPaintEvent *e) {
+	auto p = QPainter(this);
+	p.fillRect(rect(), QColor(23, 33, 43));
+	p.fillRect(0, 0, 3, height(), QColor(51, 144, 236));
+}
+
+void SearchPanel::dragEnterEvent(QDragEnterEvent *e) {
+	if (!ZipPathsFromMime(e->mimeData()).isEmpty()) {
+		e->setDropAction(Qt::CopyAction);
+		e->accept();
+	}
+}
+
+void SearchPanel::dropEvent(QDropEvent *e) {
+	if (TryImportDroppedZip(
+			e->mimeData(),
+			&_controller->session().domain())) {
+		e->acceptProposedAction();
+	}
+}
+
+bool SearchPanel::matchFilter(not_null<PeerData*> peer) const {
+	switch (_filter) {
+	case Filter::All: return true;
+	case Filter::User: return peer->isUser() && !peer->isBot();
+	case Filter::Group: return peer->isChat() || peer->isMegagroup();
+	case Filter::Channel: return peer->isBroadcast();
+	case Filter::Bot: return peer->isUser() && peer->isBot();
+	}
+	return true;
+}
+
+void SearchPanel::requestSearch() {
+	if (_text.isEmpty()) {
+		return;
+	}
+	auto &api = _controller->session().api();
+	if (_requestId) {
+		api.request(base::take(_requestId)).cancel();
+	}
+	using Flag = MTPmessages_SearchGlobal::Flag;
+	// Flag is an enum class. operator|= exists only on base::flags<Flag>.
+	auto flags = base::flags<Flag>(Flag::f_folder_id);
+	if (_filter == Filter::User || _filter == Filter::Bot) {
+		flags |= Flag::f_users_only;
+	} else if (_filter == Filter::Group) {
+		flags |= Flag::f_groups_only;
+	} else if (_filter == Filter::Channel) {
+		flags |= Flag::f_broadcasts_only;
+	}
+	_hint->setText(QString::fromUtf8("搜索中…"));
+	_requestId = api.request(MTPmessages_SearchGlobal(
+		MTP_flags(flags),
+		MTP_int(0),
+		MTPInputChannel(),
+		MTP_string(_text),
+		MTP_inputMessagesFilterEmpty(),
+		MTP_int(0),
+		MTP_int(0),
+		MTP_int(0),
+		MTP_inputPeerEmpty(),
+		MTP_int(0),
+		MTP_int(50)
+	)).done([=](const MTPmessages_Messages &result) {
+		_requestId = 0;
+		applyResult(result);
+	}).fail([=] {
+		_requestId = 0;
+		_hint->setText(QString::fromUtf8("搜索失败"));
+	}).send();
+}
+
+void SearchPanel::applyResult(const MTPmessages_Messages &result) {
+	auto &owner = _controller->session().data();
+	_list->clear();
+	_hits.clear();
+
+	const auto consume = [&](const auto &data) {
+		owner.processUsers(data.vusers());
+		owner.processChats(data.vchats());
+		for (const auto &message : data.vmessages().v) {
+			const auto item = owner.addNewMessage(
+				message,
+				MessageFlags(),
+				NewMessageType::Existing);
+			if (!item) {
+				continue;
+			}
+			const auto peer = item->history()->peer;
+			if (!matchFilter(peer)) {
+				continue;
+			}
+			_hits.push_back(item->fullId());
+			const auto snippet = item->notificationText().text;
+			const auto row = new QListWidgetItem(
+				peer->name()
+					+ u"  ["_q
+					+ KindLabel(peer)
+					+ u"]\n"_q
+					+ snippet);
+			row->setForeground(QColor(255, 255, 255));
+			_list->addItem(row);
+		}
+	};
+	result.match([&](const MTPDmessages_messages &data) {
+		consume(data);
+	}, [&](const MTPDmessages_messagesSlice &data) {
+		consume(data);
+	}, [&](const MTPDmessages_channelMessages &data) {
+		consume(data);
+	}, [&](const MTPDmessages_messagesNotModified &) {
+	});
+	_hint->setText(QString::fromUtf8("底部结果 · %1 条").arg(_hits.size()));
+}
+
+void SearchPanel::openRow(int row) {
+	if (row < 0 || row >= int(_hits.size())) {
+		return;
+	}
+	const auto id = _hits[row];
+	const auto item = _controller->session().data().message(id);
+	if (!item) {
+		return;
+	}
+	_controller->showPeerHistory(
+		item->history()->peer,
+		Window::SectionShow::Way::Forward,
+		item->fullId().msg);
+}
+
+} // namespace Custom
