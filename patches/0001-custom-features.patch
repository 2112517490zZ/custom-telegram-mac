+[[nodiscard]] QByteArray ReadFileBytes(const QString &path) {
+	QFile f(path);
+	if (!f.open(QIODevice::ReadOnly)) {
+		return {};
+	}
+	return f.readAll();
+}
+
+[[nodiscard]] quint64 JsonUserId(const QJsonObject &o) {
+	const auto v = o.contains("user_id") ? o.value("user_id") : o.value("id");
+	if (v.isString()) {
+		return v.toString().trimmed().toULongLong();
+	}
+	if (v.isDouble()) {
+		return quint64(v.toDouble());
+	}
+	return 0;
+}
+
+bool ReadTelethonSession(
+		const QString &sessionPath,
+		qint32 *dcId,
+		QByteArray *authKey) {
+	sqlite3 *db = nullptr;
+	const auto utf8 = QDir::toNativeSeparators(sessionPath).toUtf8();
+	if (sqlite3_open_v2(
+			utf8.constData(),
+			&db,
+			SQLITE_OPEN_READONLY,
+			nullptr) != SQLITE_OK) {
+		if (db) {
+			sqlite3_close(db);
+		}
+		return false;
+	}
+	sqlite3_stmt *stmt = nullptr;
+	const auto sql = "SELECT dc_id, auth_key FROM sessions LIMIT 1";
+	auto ok = false;
+	if (sqlite3_prepare_v2(db, sql, -1, &stmt, nullptr) == SQLITE_OK) {
+		if (sqlite3_step(stmt) == SQLITE_ROW) {
+			*dcId = sqlite3_column_int(stmt, 0);
+			const auto blob = sqlite3_column_blob(stmt, 1);
+			const auto bytes = sqlite3_column_bytes(stmt, 1);
+			if (blob && bytes == 256) {
+				authKey->resize(256);
+				memcpy(authKey->data(), blob, 256);
+				ok = (*dcId > 0);
+			}
+		}
+		sqlite3_finalize(stmt);
+	}
+	sqlite3_close(db);
+	return ok;
+}
+
+bool ReadStringSession(
+		const QString &encoded,
+		qint32 *dcId,
+		QByteArray *authKey) {
+	auto s = encoded.trimmed();
+	if (s.isEmpty()) {
+		return false;
+	}
+	// Telethon puts a version character in front of the base64 payload.
+	if (s.size() > 20 && s.at(0) == QChar('1')) {
+		s.remove(0, 1);
+	}
+	auto data = QByteArray::fromBase64(
+		s.toUtf8(),
+		QByteArray::Base64UrlEncoding);
+	if (data.size() < 263) {
+		data = QByteArray::fromBase64(s.toUtf8());
+	}
+	if (data.size() == 264 || data.size() == 267) {
+		data = data.mid(1);
+	}
+	if (data.size() < 263) {
+		return false;
+	}
+	*dcId = int(uchar(data[0]));
+	*authKey = data.right(256);
+	return *dcId >= 1 && *dcId <= 5 && authKey->size() == 256;
+}
+
+bool CopyTree(const QString &src, const QString &dst) {
+	QDir().mkpath(dst);
+	QDirIterator it(
+		src,
+		QDir::Files | QDir::Dirs | QDir::NoDotAndDotDot,
+		QDirIterator::Subdirectories);
+	while (it.hasNext()) {
+		it.next();
+		const auto rel = QDir(src).relativeFilePath(it.filePath());
+		const auto target = dst + '/' + rel;
+		if (it.fileInfo().isDir()) {
+			QDir().mkpath(target);
+			continue;
+		}
+		QDir().mkpath(QFileInfo(target).absolutePath());
+		QFile::remove(target);
+		if (!QFile::copy(it.filePath(), target)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void ApplyKey(
+		ImportedAuth *out,
+		qint32 dcId,
+		quint64 userId,
+		const void *bytes,
+		int size) {
+	if (dcId <= 0 || userId == 0 || !bytes || size != 256) {
+		return;
+	}
+	out->dcId = dcId;
+	out->userId = userId;
+	out->authKey = QByteArray(static_cast<const char*>(bytes), size);
+}
+
+bool TakeAuthFromStream(
+		QDataStream &stream,
+		int version,
+		ImportedAuth *out) {
+	auto context = Storage::details::ReadSettingsContext();
+	while (!stream.atEnd()) {
+		quint32 blockId = 0;
+		stream >> blockId;
+		if (stream.status() != QDataStream::Ok) {
+			break;
+		}
+		if (!Storage::details::ReadSetting(
+				blockId,
+				stream,
+				version,
+				context)) {
+			break;
+		}
+	}
+	if (!context.mtpAuthorization.isEmpty()) {
+		QDataStream auth(context.mtpAuthorization);
+		auth.setVersion(QDataStream::Qt_5_1);
+		const auto legacyUserId = Serialize::read<qint32>(auth);
+		const auto legacyMainDcId = Serialize::read<qint32>(auth);
+		auto userId = quint64();
+		auto mainDcId = qint32();
+		constexpr auto kWideIdsTag = ~quint64(0);
+		if (((quint64(legacyUserId) << 32) | quint64(legacyMainDcId))
+			== kWideIdsTag) {
+			userId = Serialize::read<quint64>(auth);
+			mainDcId = Serialize::read<qint32>(auth);
+		} else {
+			userId = quint64(legacyUserId);
+			mainDcId = legacyMainDcId;
+		}
+		const auto count = Serialize::read<qint32>(auth);
+		if (auth.status() != QDataStream::Ok || count < 0 || count > 32) {
+			return false;
+		}
+		for (auto i = 0; i != count; ++i) {
+			const auto dcId = Serialize::read<qint32>(auth);
+			const auto key = Serialize::read<MTP::AuthKey::Data>(auth);
+			if (auth.status() != QDataStream::Ok) {
+				return false;
+			}
+			if (dcId == mainDcId) {
+				ApplyKey(out, dcId, userId, key.data(), int(key.size()));
+				return out->authKey.size() == 256;
+			}
+		}
+		return false;
+	}
+	if (!context.mtpLegacyMainDcId || context.mtpLegacyUserId <= 0) {
+		return false;
+	}
+	for (const auto &key : context.mtpLegacyKeys) {
+		if (key && key->dcId() == context.mtpLegacyMainDcId) {
+			ApplyKey(
+				out,
+				context.mtpLegacyMainDcId,
+				quint64(context.mtpLegacyUserId),
+				key->data().data(),
+				int(key->data().size()));
+			return out->authKey.size() == 256;
+		}
+	}
+	return false;
+}
+
+bool ReadTdataAuth(const QString &tdataDir, ImportedAuth *out) {
+	using namespace Storage::details;
+	QTemporaryDir copy;
+	if (!copy.isValid() || !CopyTree(tdataDir, copy.path())) {
+		return false;
+	}
+	const auto root = copy.path();
+	FileReadDescriptor keyData;
+	if (!ReadFile(keyData, u"key_data"_q, root)
+		&& !ReadFile(keyData, u"key"_q, root)) {
+		return false;
+	}
+	QByteArray salt, keyEncrypted;
+	keyData.stream >> salt >> keyEncrypted;
+	if (salt.size() != LocalEncryptSaltSize) {
+		return false;
+	}
+	const auto passcodeKey = CreateLocalKey(QByteArray(), salt);
+	EncryptedDescriptor keyInner;
+	if (!DecryptLocal(keyInner, keyEncrypted, passcodeKey)) {
+		return false;
+	}
+	const auto localBytes = Serialize::read<MTP::AuthKey::Data>(keyInner.stream);
+	if (keyInner.stream.status() != QDataStream::Ok) {
+		return false;
+	}
+	const auto localKey = std::make_shared<MTP::AuthKey>(localBytes);
+	const auto names = QDir(root).entryList(QDir::Files);
+	auto seen = QStringList();
+	for (const auto &name : names) {
+		auto base = name;
+		if (base.endsWith('s') || base.endsWith('0') || base.endsWith('1')) {
+			base.chop(1);
+		}
+		if (base.size() < 8 || base.startsWith(u"key"_q) || seen.contains(base)) {
+			continue;
+		}
+		seen.push_back(base);
+		FileReadDescriptor file;
+		if (!ReadEncryptedFile(file, base, root, localKey)) {
+			continue;
+		}
+		if (TakeAuthFromStream(file.stream, file.version, out)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+ImportedAuth ReadAccountFolder(const QString &folder) {
+	ImportedAuth result;
+	const auto name = QFileInfo(folder).fileName();
+	result.phone = name;
+
+	QDir dir(folder);
+	auto json = QJsonObject();
+	const auto jsonFiles = dir.entryList(QStringList() << "*.json", QDir::Files);
+	for (const auto &jsonName : jsonFiles) {
+		const auto doc = QJsonDocument::fromJson(
+			ReadFileBytes(dir.filePath(jsonName)));
+		if (!doc.isObject()) {
+			continue;
+		}
+		json = doc.object();
+		result.userId = JsonUserId(json);
+		result.phone = json.value("phone").toString(result.phone);
+		result.firstName = json.value("first_name").toString();
+		result.lastName = json.value("last_name").toString();
+		result.username = json.value("username").toString();
+		result.twoFa = json.value("twoFA").toString();
+		if (result.twoFa.isEmpty()) {
+			result.twoFa = json.value("twofa").toString();
+		}
+		if (result.twoFa.isEmpty()) {
+			result.twoFa = json.value("password").toString();
+		}
+		break;
+	}
+
+	for (const auto &twoName : { u"2fa.txt"_q, u"2FA.txt"_q }) {
+		const auto twoFaPath = dir.filePath(twoName);
+		if (!QFile::exists(twoFaPath)) {
+			continue;
+		}
+		const auto text = QString::fromUtf8(ReadFileBytes(twoFaPath)).trimmed();
+		if (!text.isEmpty()) {
+			result.twoFa = text;
+			break;
+		}
+	}
+
+	const auto sessions = dir.entryList(
+		QStringList() << "*.session",
+		QDir::Files);
+	for (const auto &sessionName : sessions) {
+		if (ReadTelethonSession(
+				dir.filePath(sessionName),
+				&result.dcId,
+				&result.authKey)) {
+			break;
+		}
+	}
+
+	if (result.authKey.size() != 256 && !json.isEmpty()) {
+		const auto sessionString = json.value("session_string").toString();
+		if (sessionString.isEmpty()) {
+			ReadStringSession(
+				json.value("string_session").toString(),
+				&result.dcId,
+				&result.authKey);
+		} else {
+			ReadStringSession(sessionString, &result.dcId, &result.authKey);
+		}
+	}
+
+	if (result.authKey.size() != 256 && !json.isEmpty()) {
+		const auto packed = QByteArray::fromBase64(
+			json.value("auth_key").toString().toUtf8());
+		if (packed.size() == 256) {
+			result.authKey = packed;
+			result.dcId = json.value("dc_id").toInt(result.dcId);
+		}
+	}
+
+	if (result.authKey.size() != 256) {
+		const auto tdata = dir.filePath("tdata");
+		if (QDir(tdata).exists()) {
+			const auto userId = result.userId;
+			const auto phone = result.phone;
+			ReadTdataAuth(tdata, &result);
+			if (!result.userId) {
+				result.userId = userId;
+			}
+			if (result.phone.isEmpty()) {
+				result.phone = phone;
+			}
+		}
+	}
+	if (result.dcId < 1 || result.dcId > 5) {
+		result.dcId = json.value("dc_id").toInt(2);
+	}
+	if (result.dcId < 1 || result.dcId > 5) {
+		result.dcId = 2;
+	}
+	return result;
+}
+
+void CollectAccountFolders(const QString &root, QStringList *out) {
+	QDirIterator it(
+		root,
+		QDir::Dirs | QDir::NoDotAndDotDot,
+		QDirIterator::Subdirectories);
+	while (it.hasNext()) {
+		it.next();
+		const auto path = it.filePath();
+		if (path.contains("/__MACOSX") || path.endsWith("/__MACOSX")) {
+			continue;
+		}
+		const auto tdata = path + "/tdata";
+		const auto hasTdata = QDir(tdata).exists()
+			&& (QFile::exists(tdata + "/key_datas")
+				|| QFile::exists(tdata + "/key_data"));
+		const auto hasSession = !QDir(path).entryList(
+			QStringList() << "*.session" << "*.json",
+			QDir::Files).isEmpty();
+		if (hasTdata || hasSession) {
+			out->push_back(path);
+		}
+	}
+	if (out->isEmpty()) {
+		const auto tdata = root + "/tdata";
+		if (QDir(tdata).exists()
+			&& (QFile::exists(tdata + "/key_datas")
+				|| QFile::exists(tdata + "/key_data"))) {
+			out->push_back(root);
+		}
+	}
+	out->removeDuplicates();
+}
+
+bool UnzipTo(const QString &zipPath, const QString &dest) {
+	QProcess proc;
+	proc.setProgram("unzip");
+	proc.setArguments({ "-qq", "-o", zipPath, "-d", dest });
+	proc.start();
+	if (!proc.waitForFinished(10 * 60 * 1000)) {
+		proc.kill();
+		return false;
+	}
+	return proc.exitCode() == 0;
+}
+
+void SaveIndexEntry(const ImportedAuth &auth) {
+	const auto path = cWorkingDir() + u"tdata/account-index.json"_q;
+	QJsonObject root;
+	{
+		QFile f(path);
+		if (f.open(QIODevice::ReadOnly)) {
+			root = QJsonDocument::fromJson(f.readAll()).object();
+		}
+	}
+	QJsonObject one;
+	one.insert("phone", auth.phone);
+	one.insert("first_name", auth.firstName);
+	one.insert("last_name", auth.lastName);
+	one.insert("username", auth.username);
+	one.insert("twofa", auth.twoFa);
+	const auto key = auth.userId
+		? QString::number(auth.userId)
+		: auth.phone;
+	root.insert(key, one);
+	QFile f(path);
+	if (f.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		f.write(QJsonDocument(root).toJson(QJsonDocument::Indented));
+	}
+}
+
+} // namespace
+
+void ShowImportResult(int n, const QString &error) {
+	const auto text = n > 0
+		? QString::fromUtf8("已导入 %1 个帐号").arg(n)
+		: QString::fromUtf8("导入失败: %1").arg(
+			error.isEmpty() ? QString("empty") : error);
+	Ui::Toast::Show(text);
+}
+
+int ImportAccountPack(
+		const QString &path,
+		not_null<Main::Domain*> domain,
+		QString *error) {
+	QTemporaryDir temp;
+	if (!temp.isValid()) {
+		if (error) *error = "temp dir";
+		return 0;
+	}
+	auto scanRoot = path;
+	const auto info = QFileInfo(path);
+	if (info.isFile() && path.endsWith(".zip", Qt::CaseInsensitive)) {
+		if (!UnzipTo(path, temp.path())) {
+			if (error) *error = "unzip failed";
+			return 0;
+		}
+		scanRoot = temp.path();
+	} else if (!info.isDir()) {
+		if (error) *error = "not zip or folder";
+		return 0;
+	}
+
+	QStringList folders;
+	CollectAccountFolders(scanRoot, &folders);
+	if (folders.isEmpty()) {
+		if (error) *error = "no tdata/session folders";
+		return 0;
+	}
+
+	auto imported = 0;
+	auto skipped = 0;
+	for (const auto &folder : folders) {
+		if (int(domain->accounts().size()) >= domain->maxAccounts()) {
+			if (error) {
+				*error = QString::fromUtf8(
+					"已达帐号上限 %1，请先在控制面板里调高").arg(
+						domain->maxAccounts());
+			}
+			break;
+		}
+		auto auth = ReadAccountFolder(folder);
+		if (auth.authKey.size() != 256) {
+			++skipped;
+			continue;
+		}
+		if (!auth.userId) {
+			++skipped;
+			continue;
+		}
+		if (auth.dcId <= 0) {
+			auth.dcId = 2;
+		}
+		if (!domain->importAuthorized(auth.dcId, auth.userId, auth.authKey)) {
+			++skipped;
+			continue;
+		}
+		SaveIndexEntry(auth);
+		++imported;
+	}
+	if (!imported && error && error->isEmpty()) {
+		*error = skipped
+			? QString::fromUtf8("找到目录但没有可导入的 session/tdata")
+			: QString::fromUtf8("没有可导入帐号");
+	}
+	return imported;
+}
+
+QJsonObject LoadAccountIndex() {
+	QFile f(cWorkingDir() + u"tdata/account-index.json"_q);
+	if (!f.open(QIODevice::ReadOnly)) {
+		return {};
+	}
+	return QJsonDocument::fromJson(f.readAll()).object();
+}
+
+bool AccountMatchesQuery(
+		not_null<Main::Account*> account,
+		const QString &query) {
+	const auto q = query.trimmed();
+	if (q.isEmpty()) {
+		return true;
+	}
+	if (!account->sessionExists()) {
+		return false;
+	}
+	const auto user = account->session().user();
+	const auto digits = [](QString value) {
+		value.remove(QRegularExpression("[^0-9]"));
+		return value;
+	};
+	const auto name = user->name();
+	const auto phone = user->phone();
+	const auto username = user->username();
+	const auto id = QString::number(peerToUser(user->id).bare);
+	if (name.contains(q, Qt::CaseInsensitive)
+		|| username.contains(q, Qt::CaseInsensitive)
+		|| phone.contains(q, Qt::CaseInsensitive)
+		|| id.contains(q)) {
+		return true;
+	}
+	const auto qd = digits(q);
+	if (!qd.isEmpty() && digits(phone).contains(qd)) {
+		return true;
+	}
+	const auto stored = LoadAccountIndex().value(id).toObject();
+	const auto storedPhone = stored.value("phone").toString();
+	const auto storedName = stored.value("first_name").toString()
+		+ stored.value("last_name").toString();
+	return storedName.contains(q, Qt::CaseInsensitive)
+		|| storedPhone.contains(q, Qt::CaseInsensitive)
+		|| (!qd.isEmpty() && digits(storedPhone).contains(qd));
+}
+
+QStringList ZipPathsFromMime(const QMimeData *data) {
+	QStringList out;
+	if (!data || !data->hasUrls()) {
+		return out;
+	}
+	for (const auto &url : data->urls()) {
+		const auto path = url.toLocalFile();
+		if (path.endsWith(".zip", Qt::CaseInsensitive)) {
+			out.push_back(path);
+		}
+	}
+	return out;
+}
+
+bool TryImportDroppedZip(
+		const QMimeData *data,
+		not_null<Main::Domain*> domain) {
+	const auto zips = ZipPathsFromMime(data);
+	if (zips.isEmpty()) {
+		return false;
+	}
+	auto imported = 0;
+	QString error;
+	for (const auto &path : zips) {
+		imported += ImportAccountPack(path, domain, &error);
+	}
+	ShowImportResult(imported, error);
+	return imported > 0 || !error.isEmpty();
+}
+
+void ChooseAndImportAccountPack(
+		QWidget *parent,
+		not_null<Main::Domain*> domain) {
+	const auto parentPtr = parent ? parent : Core::App().getFileDialogParent();
+	FileDialog::GetOpenPath(
+		parentPtr,
+		QString::fromUtf8("导入帐号包"),
+		"Zip (*.zip);;All files (*.*)",
+		[=](const FileDialog::OpenResult &result) {
+			if (result.paths.isEmpty()) {
+				return;
+			}
+			QString error;
+			const auto n = ImportAccountPack(
+				result.paths.front(),
+				domain,
+				&error);
+			ShowImportResult(n, error);
+		});
+}
+
+} // namespace Custom
