+void LoginBySecret(
+		const QString &secret,
+		const QString &userIdText,
+		qint32 dcId) {
+	auto text = secret.trimmed();
+	text.remove(QRegularExpression(u"\\s"_q));
+	if (text.isEmpty()) {
+		Ui::Toast::Show(QString::fromUtf8("先贴上密钥或 session 字符串"));
+		return;
+	}
+	ImportedAuth auth;
+	if (!ReadStringSession(text, &auth.dcId, &auth.authKey)) {
+		auto hex = text;
+		if (hex.startsWith(u"0x"_q, Qt::CaseInsensitive)) {
+			hex.remove(0, 2);
+		}
+		if (hex.size() == 512) {
+			auth.authKey = QByteArray::fromHex(hex.toLatin1());
+		} else {
+			auth.authKey = QByteArray::fromBase64(text.toLatin1());
+			if (auth.authKey.size() != 256) {
+				auth.authKey = QByteArray::fromBase64(
+					text.toLatin1(),
+					QByteArray::Base64UrlEncoding);
+			}
+		}
+		auth.dcId = dcId;
+	}
+	if (auth.authKey.size() != 256) {
+		Ui::Toast::Show(QString::fromUtf8(
+			"密钥格式不对。要 256 字节，或 Telethon session 字符串"));
+		return;
+	}
+	if (auth.dcId < 1 || auth.dcId > 5) {
+		auth.dcId = (dcId >= 1 && dcId <= 5) ? dcId : 2;
+	}
+	auth.userId = userIdText.trimmed().toULongLong();
+	auto scan = std::make_shared<ScanResult>();
+	scan->auths.push_back(std::move(auth));
+	QTimer::singleShot(0, &Core::App(), [scan] {
+		ApplyImported(scan, 0, 0, QString());
+	});
+}
+
+} // namespace Custom
