+			QString::number(Core::App().domain().maxAccounts())));
+		const auto token = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(QString::fromUtf8("机器人 Token")),
+			saved.value("token").toString()));
+		const auto admin = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(QString::fromUtf8("管理员 ID")),
+			saved.value("admin_id").toString()));
+		const auto enabled = box->addRow(object_ptr<Ui::Checkbox>(
+			box,
+			QString::fromUtf8("自动运行机器人"),
+			saved.value("enabled").toBool(),
+			st::defaultBoxCheckbox));
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(QString::fromUtf8(
+				"导出的号包由机器人发给这个管理员。"
+				"机器人按钮在 TelegramForcePortable/bot/run，改那个文件不用重新编译。"
+				"里面可以导入、导出、看列表、发消息，再加按钮也只改这个文件。")),
+			st::boxLabel));
+		box->addButton(tr::lng_settings_save(), [=] {
+			auto n = limit->getLastText().trimmed().toInt();
+			n = std::clamp(n, 1, Main::Domain::kMaxAccounts);
+			SetEnhancedValue("max_accounts", n);
+			EnhancedSettings::Write();
+			Core::App().domain().notifyMaxAccounts(n);
+			WriteConfig(
+				token->getLastText().trimmed(),
+				admin->getLastText().trimmed(),
+				enabled->checked());
+			if (enabled->checked()) {
+				StartServe();
+			}
+			box->closeBox();
+			Ui::Toast::Show(QString::fromUtf8("已保存。帐号上限 %1。").arg(n));
+		});
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	}));
+}
