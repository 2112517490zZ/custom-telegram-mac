+[[nodiscard]] Main::Account *FindByPhone(const QString &phone) {
+	const auto wanted = Digits(phone);
+	if (wanted.isEmpty() || !Core::App().domain().started()) {
+		return nullptr;
+	}
+	for (const auto account : Core::App().domain().orderedAccounts()) {
+		if (!account->sessionExists()) {
+			continue;
+		}
+		if (Digits(account->session().user()->phone()) == wanted) {
+			return account.get();
+		}
+	}
+	return nullptr;
+}
