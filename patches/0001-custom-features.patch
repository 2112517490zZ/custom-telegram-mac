+namespace Custom {
+
+[[nodiscard]] inline bool IsPersonalUser(PeerData *peer) {
+	const auto user = peer ? peer->asUser() : nullptr;
+	return user
+		&& !user->isBot()
+		&& !user->isSelf()
+		&& !user->isNotificationsUser()
+		&& !user->isRepliesChat()
+		&& !user->isVerifyCodes();
+}
+
+} // namespace Custom
