+void FinishImport(const QString &path, not_null<Main::Domain*> domain) {
+	Ui::Toast::Show(QString::fromUtf8("正在导入，请稍等"));
+	SetFileDialogActive(true);
+	crl::async([path] {
+		auto scan = std::make_shared<ScanResult>(ScanAccounts(path));
+		crl::on_main(&Core::App(), [scan] {
+			if (scan->auths.empty()) {
+				ReleaseFileDialog();
+				ShowImportResult(0, scan->error);
+				return;
+			}
+			ApplyImported(scan, 0, 0, scan->error);
+		});
+	});
+	(void)domain;
+}
