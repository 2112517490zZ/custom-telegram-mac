+void LoginSheet::setStatus(const QString &text) {
+	_status->setText(text);
+}
+
+bool LoginSheet::ensureAccount() {
+	if (_account) {
+		return true;
+	}
+	auto &domain = Core::App().domain();
+	if (!domain.started()) {
+		fail(QString::fromUtf8("客户端还没准备好"));
+		return false;
+	}
+	// Do not remove accounts here. That runs inside the mouse click and
+	// can destroy the window before this call returns.
+	if (int(domain.accounts().size()) >= domain.maxAccounts()) {
+		fail(QString::fromUtf8(
+			"已达帐号上限 %1，先在控制面板调高").arg(domain.maxAccounts()));
+		return false;
+	}
+	_account = domain.add(MTP::Environment{}).get();
+	HoldAccount(_account);
+	_api = std::make_unique<MTP::Sender>(&_account->mtp());
+	return true;
+}
+
+void LoginSheet::fail(const QString &text) {
+	setStatus(text);
+	Ui::Toast::Show(text);
+}
+
+void LoginSheet::acceptAuth(const MTPauth_Authorization &auth) {
+	auth.match([&](const MTPDauth_authorization &data) {
+		const auto user = data.vuser();
+		if (user.type() != mtpc_user || !user.c_user().is_self()) {
+			fail(QString::fromUtf8("服务器没有返回可用的帐号"));
+			return;
+		}
+		const auto id = UserId(user.c_user().vid());
+		for (const auto &[index, existing] : Core::App().domain().accounts()) {
+			(void)index;
+			if (existing.get() == _account) {
+				continue;
+			}
+			if (const auto session = existing->maybeSession()) {
+				if (session->userId() == id) {
+					ReleaseAccount(_account);
+					const auto keep = existing.get();
+					_account = nullptr;
+					_sheet->deleteLater();
+					keep->domain().activate(keep);
+					return;
+				}
+			}
+		}
+		_account->createSession(
+			user,
+			std::make_unique<Main::SessionSettings>());
+		_account->local().writeMtpData();
+		const auto added = _account;
+		ReleaseAccount(added);
+		_sheet->deleteLater();
+		added->domain().activate(added);
+	}, [&](const MTPDauth_authorizationSignUpRequired &) {
+		fail(QString::fromUtf8("这个号码还没注册"));
+	});
+}
+
+void LoginSheet::askPassword() {
+	if (!ensureAccount()) {
+		return;
+	}
+	_needPassword = true;
+	_password->show();
+	_password->setFocus();
+	setStatus(QString::fromUtf8("这个号开了两步验证，输入密码后再点登录"));
+	showPage(2);
+	_requestId = _api->request(MTPaccount_GetPassword(
+	)).done(crl::guard(this, [=](const MTPaccount_Password &result) {
+		_requestId = 0;
+		result.match([&](const MTPDaccount_password &data) {
+			_passwordState = Core::ParseCloudPasswordState(data);
+			if (!_passwordState.hasPassword) {
+				fail(QString::fromUtf8("服务器没有给出密码校验"));
+			}
+		});
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		_requestId = 0;
+		fail(error.type());
+	})).send();
+}
+
+void LoginSheet::submitPassword() {
+	if (!_passwordState.mtp.request) {
+		fail(QString::fromUtf8("密码校验还没准备好"));
+		return;
+	}
+	const auto password = _password->text().toUtf8();
+	const auto hash = Core::ComputeCloudPasswordHash(
+		_passwordState.mtp.request.algo,
+		bytes::make_span(password));
+	const auto check = Core::ComputeCloudPasswordCheck(
+		_passwordState.mtp.request,
+		hash);
+	if (!check) {
+		fail(QString::fromUtf8("这个客户端算不出这套密码"));
+		return;
+	}
+	_passwordState.mtp.request.id = 0;
+	_requestId = _api->request(
+		MTPauth_CheckPassword(check.result)
+	).done(crl::guard(this, [=](const MTPauth_Authorization &result) {
+		_requestId = 0;
+		acceptAuth(result);
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		_requestId = 0;
+		fail(error.type() == u"PASSWORD_HASH_INVALID"_q
+			? QString::fromUtf8("密码不对")
+			: error.type());
+	})).send();
+}
+
+void LoginSheet::showQrImage(const QByteArray &token) {
+	auto link = QByteArray("tg://login?token=");
+	link += token.toBase64(QByteArray::Base64UrlEncoding);
+	const auto data = Qr::Encode(link, Qr::Redundancy::Quartile);
+	if (data.size <= 0) {
+		fail(QString::fromUtf8("二维码没有生成出来"));
+		return;
+	}
+	const auto image = Qr::Generate(data, 8, Qt::black);
+	_qr->setPixmap(QPixmap::fromImage(image).scaled(
+		220,
+		220,
+		Qt::KeepAspectRatio,
+		Qt::SmoothTransformation));
+	setStatus(QString::fromUtf8("用已经登录的 Telegram 扫这个码"));
+}
+
+void LoginSheet::handleToken(const MTPauth_LoginToken &result) {
+	result.match([&](const MTPDauth_loginToken &data) {
+		_requestId = 0;
+		showQrImage(data.vtoken().v);
+		const auto left = data.vexpires().v - base::unixtime::now();
+		_qrTimer.start(std::max(left, 1) * crl::time(1000));
+	}, [&](const MTPDauth_loginTokenMigrateTo &data) {
+		_api->instance().setMainDcId(data.vdc_id().v);
+		_requestId = _api->request(MTPauth_ImportLoginToken(
+			MTP_bytes(data.vtoken().v)
+		)).done(crl::guard(this, [=](const MTPauth_LoginToken &next) {
+			handleToken(next);
+		})).fail(crl::guard(this, [=](const MTP::Error &error) {
+			_requestId = 0;
+			if (error.type() == u"SESSION_PASSWORD_NEEDED"_q) {
+				askPassword();
+			} else {
+				fail(error.type());
+			}
+		})).toDC(data.vdc_id().v).send();
+	}, [&](const MTPDauth_loginTokenSuccess &data) {
+		_requestId = 0;
+		_qrTimer.stop();
+		acceptAuth(data.vauthorization());
+	});
+}
+
+void LoginSheet::refreshQr() {
+	if (!ensureAccount() || _requestId) {
+		return;
+	}
+	setStatus(QString::fromUtf8("正在向服务器要二维码"));
+	_requestId = _api->request(MTPauth_ExportLoginToken(
+		MTP_int(ApiId),
+		MTP_string(ApiHash),
+		MTP_vector<MTPlong>(0)
+	)).done(crl::guard(this, [=](const MTPauth_LoginToken &result) {
+		handleToken(result);
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		_requestId = 0;
+		if (error.type() == u"SESSION_PASSWORD_NEEDED"_q) {
+			askPassword();
+		} else {
+			fail(error.type());
+		}
+	})).send();
+}
+
+void LoginSheet::sendCode() {
+	if (!ensureAccount()) {
+		return;
+	}
+	auto phone = _phone->text();
+	phone.remove(QChar(' '));
+	phone.remove(QChar('-'));
+	if (phone.startsWith(u"+"_q)) {
+		phone.remove(0, 1);
+	}
+	if (phone.size() < 6) {
+		fail(QString::fromUtf8("先输入手机号，带国家码"));
+		return;
+	}
+	_api->instance().setUserPhone(phone);
+	setStatus(QString::fromUtf8("正在发送验证码"));
+	_requestId = _api->request(MTPauth_SendCode(
+		MTP_string(phone),
+		MTP_int(ApiId),
+		MTP_string(ApiHash),
+		MTP_codeSettings(
+			MTP_flags(0),
+			MTPVector<MTPbytes>(),
+			MTPstring(),
+			MTPBool())
+	)).done(crl::guard(this, [=](const MTPauth_SentCode &result) {
+		_requestId = 0;
+		result.match([&](const MTPDauth_sentCode &data) {
+			_phoneHash = data.vphone_code_hash().v;
+			_code->show();
+			_code->setFocus();
+			setStatus(QString::fromUtf8("验证码已发送，填上后点登录"));
+		}, [&](const MTPDauth_sentCodeSuccess &data) {
+			acceptAuth(data.vauthorization());
+		}, [&](const MTPDauth_sentCodePaymentRequired &) {
+			fail(QString::fromUtf8("这个号码要先付费才能收验证码"));
+		});
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		_requestId = 0;
+		const auto type = error.type();
+		if (type.startsWith(u"PHONE_MIGRATE_"_q)) {
+			const auto dc = type.mid(14).toInt();
+			if (dc > 0) {
+				_api->instance().setMainDcId(dc);
+				sendCode();
+				return;
+			}
+		}
+		fail(type);
+	})).send();
+}
+
+void LoginSheet::signIn() {
+	if (_needPassword) {
+		submitPassword();
+		return;
+	}
+	if (!ensureAccount()) {
+		return;
+	}
+	if (_phoneHash.isEmpty()) {
+		fail(QString::fromUtf8("先获取验证码"));
+		return;
+	}
+	auto phone = _phone->text();
+	phone.remove(QChar(' '));
+	phone.remove(QChar('-'));
+	if (phone.startsWith(u"+"_q)) {
+		phone.remove(0, 1);
+	}
+	const auto code = _code->text().trimmed();
+	if (code.isEmpty()) {
+		fail(QString::fromUtf8("先填写验证码"));
+		return;
+	}
+	_requestId = _api->request(MTPauth_SignIn(
+		MTP_flags(MTPauth_SignIn::Flag::f_phone_code),
+		MTP_string(phone),
+		MTP_bytes(_phoneHash),
+		MTP_string(code),
+		MTP_emailVerificationCode(MTP_string())
+	)).done(crl::guard(this, [=](const MTPauth_Authorization &result) {
+		_requestId = 0;
+		acceptAuth(result);
+	})).fail(crl::guard(this, [=](const MTP::Error &error) {
+		_requestId = 0;
+		if (error.type() == u"SESSION_PASSWORD_NEEDED"_q) {
+			askPassword();
+		} else {
+			fail(error.type());
+		}
+	})).send();
+}
+
+void LoginSheet::startPasskey() {
+	if (!ensureAccount()) {
+		return;
+	}
+	if (!Platform::WebAuthn::IsSupported()) {
+		fail(QString::fromUtf8("这台系统没有通行密钥"));
+		return;
+	}
+	setStatus(QString::fromUtf8("正在调用系统通行密钥"));
+	const auto initialDc = _api->instance().mainDcId();
+	::Data::InitPasskeyLogin(*_api, crl::guard(this, [=](
+			const ::Data::Passkey::LoginData &loginData) {
+		_passkeyDc = initialDc;
+		Platform::WebAuthn::Login(loginData, crl::guard(this, [=](
+				Platform::WebAuthn::LoginResult result) {
+			if (result.userHandle.isEmpty()) {
+				if (result.error == Platform::WebAuthn::Error::UnsignedBuild) {
+					fail(QString::fromUtf8(
+						"通行密钥要求应用有系统签名，这个包还没签"));
+				} else if (result.error == Platform::WebAuthn::Error::Cancelled) {
+					setStatus(QString::fromUtf8("已取消通行密钥"));
+				} else {
+					fail(QString::fromUtf8("通行密钥没有完成"));
+				}
+				return;
+			}
+			::Data::FinishPasskeyLogin(
+				*_api,
+				_passkeyDc,
+				result,
+				crl::guard(this, [=](const MTPauth_Authorization &auth) {
+					acceptAuth(auth);
+				}),
+				crl::guard(this, [=](QString error) {
+					if (error == u"SESSION_PASSWORD_NEEDED"_q) {
+						askPassword();
+					} else {
+						fail(error);
+					}
+				}));
+		}));
+	}));
+}
+
+void LoginSheet::buildHome() {
+	auto *page = new QWidget(_stack);
+	auto *layout = new QVBoxLayout(page);
+	layout->setContentsMargins(0, 0, 0, 0);
+	layout->setSpacing(8);
+	auto *title = new QLabel(QString::fromUtf8("添加帐号"), page);
+	title->setStyleSheet(u"font-size:16px;font-weight:600;"_q);
+	auto *hint = new QLabel(QString::fromUtf8(
+		"二维码、手机号、通行密钥都在这个窗口里完成。"), page);
+	hint->setWordWrap(true);
+	layout->addWidget(title);
+	layout->addWidget(hint);
+	const auto button = [&](const QString &text) {
+		auto *widget = MakeButton(text, page);
+		layout->addWidget(widget);
+		return widget;
+	};
+	connect(button(QString::fromUtf8("二维码")), &QPushButton::clicked, this, [=] {
+		showPage(1);
+		setStatus(QString::fromUtf8("正在向服务器要二维码"));
+		// domain.add / MTP inside this click calls AppKit before mouseUp
+		// and the process never returns.
+		QTimer::singleShot(0, this, [=] { refreshQr(); });
+	});
+	connect(button(QString::fromUtf8("手机号")), &QPushButton::clicked, this, [=] {
+		showPage(2);
+		QTimer::singleShot(0, this, [=] {
+			_phone->setFocus();
+			setStatus(QString::fromUtf8("输入手机号，点获取验证码"));
+		});
+	});
+	connect(button(QString::fromUtf8("通行密钥")), &QPushButton::clicked, this, [=] {
+		QTimer::singleShot(0, this, [=] { startPasskey(); });
+	});
+	connect(button(QString::fromUtf8("导入压缩包")), &QPushButton::clicked, this, [=] {
+		_sheet->deleteLater();
+		QTimer::singleShot(0, &Core::App(), [] {
+			ChooseAndImportAccountPack(nullptr, &Core::App().domain());
+		});
+	});
+	connect(button(QString::fromUtf8("关闭")), &QPushButton::clicked, this, [=] {
+		_sheet->deleteLater();
+	});
+	layout->addStretch(1);
+	_stack->addWidget(page);
+}
+
+void LoginSheet::buildQr() {
+	auto *page = new QWidget(_stack);
+	auto *layout = new QVBoxLayout(page);
+	layout->setContentsMargins(0, 0, 0, 0);
+	layout->setSpacing(8);
+	auto *title = new QLabel(QString::fromUtf8("扫码登录"), page);
+	title->setStyleSheet(u"font-size:16px;font-weight:600;"_q);
+	_qr = new QLabel(page);
+	_qr->setFixedSize(220, 220);
+	_qr->setAlignment(Qt::AlignCenter);
+	_qr->setStyleSheet(u"background:#ffffff;border-radius:8px;"_q);
+	layout->addWidget(title);
+	layout->addWidget(_qr, 0, Qt::AlignHCenter);
+	auto *back = MakeButton(QString::fromUtf8("返回"), page);
+	layout->addWidget(back);
+	layout->addStretch(1);
+	connect(back, &QPushButton::clicked, this, [=] {
+		_qrTimer.stop();
+		if (_api && _requestId) {
+			_api->request(base::take(_requestId)).cancel();
+		}
+		showPage(0);
+		setStatus(QString());
+	});
+	_stack->addWidget(page);
+}
+
+void LoginSheet::buildPhone() {
+	auto *page = new QWidget(_stack);
+	auto *layout = new QVBoxLayout(page);
+	layout->setContentsMargins(0, 0, 0, 0);
+	layout->setSpacing(8);
+	auto *title = new QLabel(QString::fromUtf8("手机号登录"), page);
+	title->setStyleSheet(u"font-size:16px;font-weight:600;"_q);
+	_phone = new QLineEdit(page);
+	_phone->setPlaceholderText(QString::fromUtf8("手机号，带国家码，例如 8613800138000"));
+	_code = new QLineEdit(page);
+	_code->setPlaceholderText(QString::fromUtf8("验证码"));
+	_password = new QLineEdit(page);
+	_password->setEchoMode(QLineEdit::Password);
+	_password->setPlaceholderText(QString::fromUtf8("两步验证密码"));
+	_password->hide();
+	layout->addWidget(title);
+	layout->addWidget(_phone);
+	layout->addWidget(_code);
+	layout->addWidget(_password);
+	const auto codeButton = MakeButton(QString::fromUtf8("获取验证码"), page);
+	_submit = MakeButton(QString::fromUtf8("登录"), page);
+	const auto back = MakeButton(QString::fromUtf8("返回"), page);
+	layout->addWidget(codeButton);
+	layout->addWidget(_submit);
+	layout->addWidget(back);
+	layout->addStretch(1);
+	connect(codeButton, &QPushButton::clicked, this, [=] {
+		setStatus(QString::fromUtf8("正在发送验证码"));
+		QTimer::singleShot(0, this, [=] { sendCode(); });
+	});
+	connect(_submit, &QPushButton::clicked, this, [=] {
+		QTimer::singleShot(0, this, [=] { signIn(); });
+	});
+	connect(back, &QPushButton::clicked, this, [=] {
+		_needPassword = false;
+		_password->hide();
+		showPage(0);
+		setStatus(QString());
+	});
+	_stack->addWidget(page);
+}
+
+} // namespace
+
+QWidget *CreateLoginSheet(QWidget *host) {
+	auto *sheet = new QFrame(host);
+	new LoginSheet(sheet);
+	return sheet;
+}
