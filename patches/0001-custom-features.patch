+bool WriteOneFolder(const PreparedAccount &one, const QString &root) {
+	const auto folder = root + '/' + one.folderName;
+	const auto tdata = folder + "/tdata";
+	QDir().mkpath(tdata + '/' + kTemplateHash);
+
+	{
+		QFile json(folder + '/' + one.folderName + ".json");
+		if (!json.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+			return false;
+		}
+		json.write(QJsonDocument(one.json).toJson(QJsonDocument::Indented));
+	}
+	if (!one.twoFa.isEmpty()) {
+		QFile twoFa(folder + "/2fa.txt");
+		if (twoFa.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+			twoFa.write(one.twoFa.toUtf8());
+		}
+	}
+	if (one.authKey.size() == 256) {
+		WriteTelethonSession(
+			folder + '/' + one.folderName + ".session",
+			one.dcId,
+			one.authKey);
+	}
+
+	const auto srcBase = cWorkingDir() + u"tdata/"_q;
+	CopyExisting(srcBase + "key_datas", tdata + "/key_datas");
+	if (!QFile::exists(tdata + "/key_datas")) {
+		CopyExisting(srcBase + "key_data", tdata + "/key_datas");
+	}
+
+	const auto srcHash = AccountFileHash(one.index);
+	CopyDir(srcBase + srcHash, tdata + '/' + kTemplateHash);
+	if (!CopyExisting(srcBase + srcHash + 's', tdata + '/' + kTemplateHash + 's')) {
+		if (!CopyExisting(srcBase + srcHash + '0', tdata + '/' + kTemplateHash + 's')) {
+			CopyExisting(srcBase + srcHash + '1', tdata + '/' + kTemplateHash + 's');
+		}
+	}
+	return QDir(folder).exists();
+}
+
+void RemoveIndexKeys(const QStringList &userIds) {
+	const auto path = cWorkingDir() + u"tdata/account-index.json"_q;
+	QFile f(path);
+	if (!f.open(QIODevice::ReadOnly)) {
+		return;
+	}
+	auto root = QJsonDocument::fromJson(f.readAll()).object();
+	f.close();
+	for (const auto &id : userIds) {
+		root.remove(id);
+	}
+	if (f.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		f.write(QJsonDocument(root).toJson(QJsonDocument::Indented));
+	}
+}
+
+void ShowExportResult(int n, const QString &error) {
+	Ui::Toast::Show(n > 0
+		? QString::fromUtf8("已导出 %1 个帐号，已从列表移除。登录还在，这个包可以再导入。").arg(n)
+		: QString::fromUtf8("导出失败: %1").arg(
+			error.isEmpty() ? QString("empty") : error));
+}
+
+void StartExport(
+		const std::vector<not_null<Main::Account*>> &accounts,
+		QWidget *parent) {
+	if (accounts.empty()) {
+		Ui::Toast::Show(QString::fromUtf8("没有选中帐号"));
+		return;
+	}
+	Q_UNUSED(parent);
+	const auto stamp = QDateTime::currentDateTime().toString(
+		"yyyyMMdd-HHmmss");
+	const auto dir = cWorkingDir() + u"bot/outbox/"_q;
+	QDir().mkpath(dir);
+	const auto path = dir + u"导出帐号-"_q + stamp + u".zip"_q;
+	QString error;
+	const auto n = ExportAndDeleteAccounts(accounts, path, &error);
+	if (n <= 0) {
+		QFile::remove(path);
+		ShowExportResult(0, error);
+		return;
+	}
+	if (!SendExportViaBot(path, &error)) {
+		ShowExportResult(0, error);
+		return;
+	}
+	QFile::remove(path);
+	DeleteExportedAccounts(accounts);
+	ShowExportResult(n, QString());
+}
+
+} // namespace
+
+int ExportAndDeleteAccounts(
+		const std::vector<not_null<Main::Account*>> &accounts,
+		const QString &zipPath,
+		QString *error) {
+	if (accounts.empty()) {
+		if (error) *error = "empty";
+		return 0;
+	}
+	QTemporaryDir temp;
+	if (!temp.isValid()) {
+		if (error) *error = "temp dir";
+		return 0;
+	}
+	const auto root = temp.path();
+	QDir().mkpath(root);
+
+	const auto indexRoot = LoadIndex();
+	std::vector<PreparedAccount> prepared;
+	for (const auto account : accounts) {
+		if (!account->sessionExists()) {
+			continue;
+		}
+		auto found = -1;
+		for (const auto &[index, existing] : account->domain().accounts()) {
+			if (existing.get() == account.get()) {
+				found = index;
+				break;
+			}
+		}
+		if (found < 0) {
+			continue;
+		}
+		auto one = PrepareOne(account, found, indexRoot);
+		if (!WriteOneFolder(one, root)) {
+			continue;
+		}
+		prepared.push_back(std::move(one));
+	}
+	if (prepared.empty()) {
+		if (error) *error = QString::fromUtf8("没有可导出的已登录帐号");
+		return 0;
+	}
+	if (!ZipChildren(root, zipPath)) {
+		if (error) *error = "zip failed";
+		return 0;
+	}
+	return int(prepared.size());
+}
+
+void DeleteExportedAccounts(
+		const std::vector<not_null<Main::Account*>> &accounts) {
+	std::vector<not_null<Main::Account*>> deleting;
+	Main::Account *active = nullptr;
+	const auto current = Core::App().domain().started()
+		? &Core::App().domain().active()
+		: nullptr;
+	QStringList removeIds;
+	for (const auto account : accounts) {
+		if (!account->sessionExists()) {
+			continue;
+		}
+		removeIds.push_back(QString::number(
+			peerToUser(account->session().user()->id).bare));
+		if (current && account == current) {
+			active = account;
+		} else {
+			deleting.push_back(account);
+		}
+	}
+	RemoveIndexKeys(removeIds);
+	// Drop the account from this client only. logout() tells the server to
+	// kill the session, which makes the exported tdata useless on reimport.
+	for (const auto account : deleting) {
+		account->forcedLogOut();
+	}
+	if (active) {
+		active->forcedLogOut();
+	}
+}
+
+void ChooseAndExportOne(
+		QWidget *parent,
+		not_null<Main::Account*> account) {
+	if (!account->sessionExists()) {
+		Ui::Toast::Show(QString::fromUtf8("这个号还没登录"));
+		return;
+	}
+	StartExport({ account }, parent);
+}
+
+void ChooseAndExportAccounts(
+		not_null<Window::SessionController*> controller) {
+	auto all = std::vector<not_null<Main::Account*>>();
+	for (const auto &account : controller->session().domain().orderedAccounts()) {
+		if (account->sessionExists()) {
+			all.push_back(account);
+		}
+	}
+	if (all.empty()) {
+		Ui::Toast::Show(QString::fromUtf8("没有已登录帐号可导出"));
+		return;
+	}
+
+	controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(QString::fromUtf8("批量导出帐号")));
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(QString::fromUtf8(
+				"打包后由机器人发给你。发出去才从本机列表移除，不退出登录。"
+				"发送失败号还在。这个包以后可以再导入。")),
+			st::boxLabel));
+		const auto search = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::defaultInputField,
+			rpl::single(QString::fromUtf8("搜索帐号名称 / 手机号"))));
+		const auto checks = std::make_shared<
+			std::vector<std::pair<not_null<Main::Account*>, Ui::Checkbox*>>>();
+		for (const auto account : all) {
+			const auto user = account->session().user();
+			const auto label = user->name()
+				+ ' '
+				+ (user->phone().isEmpty()
+					? QString()
+					: ('+' + user->phone()));
+			const auto check = box->addRow(object_ptr<Ui::Checkbox>(
+				box,
+				label,
+				false,
+				st::defaultBoxCheckbox));
+			checks->push_back({ account, check });
+		}
+		search->changes(
+		) | rpl::on_next([=] {
+			const auto q = search->getLastText();
+			for (const auto &[account, check] : *checks) {
+				check->setVisible(AccountMatchesQuery(account, q));
+			}
+		}, search->lifetime());
+
+		box->addButton(rpl::single(QString::fromUtf8("导出并删除")), [=] {
+			std::vector<not_null<Main::Account*>> picked;
+			for (const auto &[account, check] : *checks) {
+				if (check->checked() && !check->isHidden()) {
+					picked.push_back(account);
+				}
+			}
+			if (picked.empty()) {
+				Ui::Toast::Show(QString::fromUtf8("没有选中帐号"));
+				return;
+			}
+			box->closeBox();
+			StartExport(picked, controller->widget().get());
+		});
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	}));
+}
+
