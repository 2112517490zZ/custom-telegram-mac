+int ImportAccountPack(
+		const QString &path,
+		not_null<Main::Domain*> domain,
+		QString *error) {
+	const auto scan = ScanAccounts(path);
+	if (scan.auths.empty()) {
+		if (error) {
+			*error = scan.error.isEmpty()
+				? QString::fromUtf8("没有可导入帐号")
+				: scan.error;
+		}
+		return 0;
+	}
+	auto imported = 0;
+	for (const auto &auth : scan.auths) {
+		if (int(domain->accounts().size()) >= domain->maxAccounts()) {
+			if (error) {
+				*error = QString::fromUtf8(
+					"已达帐号上限 %1，请先在控制面板里调高").arg(
+						domain->maxAccounts());
+			}
+			break;
+		}
+		if (!domain->importAuthorized(
+				auth.dcId,
+				auth.userId,
+				auth.authKey,
+				false)) {
+			continue;
+		}
+		SaveIndexEntry(auth);
+		++imported;
+	}
+	if (imported > 0) {
+		domain->notifyAccountsChanged();
+	}
+	if (!imported && error && error->isEmpty()) {
+		*error = scan.error.isEmpty()
+			? QString::fromUtf8("没有可导入帐号")
+			: scan.error;
+	}
+	return imported;
+}
+
+void ResolveSelf(not_null<Main::Account*> account) {
+	HoldAccount(account);
+	const auto sender = std::make_shared<MTP::Sender>(&account->mtp());
+	sender->request(MTPusers_GetUsers(
+		MTP_vector<MTPInputUser>(1, MTP_inputUserSelf())
+	)).done([=](const MTPVector<MTPUser> &result) {
+		auto alive = false;
+		if (Core::App().domain().started()) {
+			for (const auto &[index, existing] : Core::App().domain().accounts()) {
+				if (existing.get() == account.get()) {
+					alive = true;
+					break;
+				}
+			}
+		}
+		if (!alive) {
+			return;
+		}
+		ReleaseAccount(account);
+		auto id = quint64();
+		for (const auto &user : result.v) {
+			user.match([&](const MTPDuser &data) {
+				if (data.is_self()) {
+					id = quint64(data.vid().v);
+				}
+			}, [](const MTPDuserEmpty &) {
+			});
+		}
+		if (!id) {
+			Ui::Toast::Show(QString::fromUtf8("服务器没有返回这个密钥对应的帐号"));
+			return;
+		}
+		if (account->sessionExists()) {
+			return;
+		}
+		account->setSessionUserId(UserId(id));
+		account->createSession(
+			UserId(id),
+			QByteArray(),
+			0,
+			std::make_unique<Main::SessionSettings>());
+		account->session().updates().getDifference();
+		account->domain().notifyAccountsChanged();
+		account->domain().activate(account);
+	}).fail([=](const MTP::Error &error) {
+		ReleaseAccount(account);
+		Ui::Toast::Show(QString::fromUtf8("密钥连接失败: ") + error.type());
+	}).send();
+}
+
+void ApplyImported(
+		const std::shared_ptr<ScanResult> &scan,
+		int index,
+		int imported,
+		QString error) {
+	auto &domain = Core::App().domain();
+	if (!domain.started()) {
+		ReleaseFileDialog();
+		ShowImportResult(0, QString::fromUtf8("客户端还没准备好"));
+		return;
+	}
+	if (index >= int(scan->auths.size())) {
+		if (imported > 0) {
+			domain.notifyAccountsChanged();
+			const auto added = domain.accounts().back().account.get();
+			ReleaseFileDialog([added] {
+				if (!Core::App().domain().started()) {
+					return;
+				}
+				auto *alive = (Main::Account*)nullptr;
+				for (const auto &[index, existing] : Core::App().domain().accounts()) {
+					(void)index;
+					if (existing.get() == added) {
+						alive = existing.get();
+						break;
+					}
+				}
+				if (!alive || !alive->sessionExists()) {
+					return;
+				}
+				alive->session().updates().getDifference();
+				alive->domain().activate(alive);
+			});
+		} else {
+			if (error.isEmpty()) {
+				error = QString::fromUtf8("没有可导入帐号");
+			}
+			ReleaseFileDialog();
+		}
+		ShowImportResult(imported, error);
+		return;
+	}
+	if (int(domain.accounts().size()) >= domain.maxAccounts()) {
+		if (error.isEmpty()) {
+			error = QString::fromUtf8(
+				"已达帐号上限 %1，请先在控制面板里调高").arg(
+					domain.maxAccounts());
+		}
+		if (imported > 0) {
+			domain.notifyAccountsChanged();
+		}
+		ReleaseFileDialog();
+		ShowImportResult(imported, error);
+		return;
+	}
+	const auto &auth = scan->auths[index];
+	auto duplicate = false;
+	if (auth.userId != 0) {
+		for (const auto &[accountIndex, existing] : domain.accounts()) {
+			(void)accountIndex;
+			if (existing->sessionExists()
+				&& existing->session().userId().bare == auth.userId) {
+				duplicate = true;
+				break;
+			}
+		}
+	}
+	if (duplicate) {
+		if (error.isEmpty()) {
+			error = QString::fromUtf8("这个号已经在列表里");
+		}
+	} else if (domain.importAuthorized(
+			auth.dcId,
+			auth.userId,
+			auth.authKey,
+			false)) {
+		SaveIndexEntry(auth);
+		++imported;
+		const auto account = domain.accounts().back().account.get();
+		if (!account->sessionExists() && auth.userId != 0) {
+			account->createSession(
+				UserId(auth.userId),
+				QByteArray(),
+				0,
+				std::make_unique<Main::SessionSettings>());
+		} else if (!account->sessionExists()) {
+			ResolveSelf(account);
+		}
+	} else if (error.isEmpty()) {
+		error = QString::fromUtf8("这个 tdata 里的密钥没有接上");
+	}
+	crl::on_main(&Core::App(), [=] {
+		ApplyImported(scan, index + 1, imported, error);
+	});
+}
