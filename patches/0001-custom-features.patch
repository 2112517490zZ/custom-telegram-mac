+void EnsureDownloadFolder() {
+	const auto path = cWorkingDir() + u"灯塔集团 魔改TG客户端/"_q;
+	QDir().mkpath(path);
+	auto &settings = Core::App().settings();
+	if (settings.downloadPath() == path && !settings.askDownloadPath()) {
+		return;
+	}
+	settings.setAskDownloadPath(false);
+	settings.setDownloadPath(path);
+	settings.setDownloadPathBookmark(psDownloadPathBookmark(path));
+	Core::App().saveSettingsDelayed();
+}
