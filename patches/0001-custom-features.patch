+[[nodiscard]] bool ServeRunning() {
+	QFile file(BotDir() + u"serve.pid"_q);
+	if (!file.open(QIODevice::ReadOnly)) {
+		return false;
+	}
+	const auto pid = QString::fromUtf8(file.readAll()).trimmed().toLongLong();
+	if (pid <= 0) {
+		return false;
+	}
+	QProcess proc;
+	proc.start("kill", { "-0", QString::number(pid) });
+	if (!proc.waitForFinished(2000)) {
+		return false;
+	}
+	return proc.exitCode() == 0;
+}
